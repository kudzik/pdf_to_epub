.venv/
__pycache__/
*.py[cod]
*$py.class

# Output files (zachowujemy strukturę katalogów przez .gitkeep)
output/markdown/*
!output/markdown/.gitkeep
!output/markdown/assets/
output/markdown/assets/*
!output/markdown/assets/.gitkeep
output/epub/*
!output/epub/.gitkeep
output/audit_report.json

# Pliki wejściowe PDF
input/*
!input/.gitkeep

# Lokalne pliki konfiguracyjne IDE
.vscode/
.idea/
*.swp


# Targeted OCR cache and local verification artifacts
output/source_cache/
web/tests/artifacts/
.uv-cache/
