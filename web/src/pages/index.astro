    window.stepScanPage = function(pIdx, delta) {
      const input = document.getElementById(`scan-page-input-${pIdx}`);
      if (!input) return;
      const current = parseInt(input.value, 10) || 1;
      const next = Math.max(1, Math.min(914, current + delta));
      input.value = next;
      input.dataset.located = 'true';
      window.reloadScan(pIdx);
    };

    window.reloadScan = function(pIdx) {
      const input = document.getElementById(`scan-page-input-${pIdx}`);
      const img = document.getElementById(`scan-img-${pIdx}`);
      const label = document.getElementById(`scan-page-label-${pIdx}`);
      const directLink = document.getElementById(`scan-direct-link-${pIdx}`);
      const currentBook = (typeof bookSelector !== 'undefined' && bookSelector && bookSelector.value) ? bookSelector.value : 'ksiazka';
      const pageVal = input ? input.value : '1';
      if (label) label.textContent = `strona ${pageVal}`;
      if (img) {
        img.src = `/api/scan-image?book=${encodeURIComponent(currentBook)}&page=${encodeURIComponent(pageVal)}&t=${Date.now()}`;
      }
      if (directLink) {
        directLink.href = `/api/scan-image?book=${encodeURIComponent(currentBook)}&page=${encodeURIComponent(pageVal)}`;
