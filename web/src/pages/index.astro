    // ----------------------------------------------------
    // SYSTEM INTERACTION LOCK & CONCURRENCY CONTROLLER
    // ----------------------------------------------------
    function setSystemBusy(busy, actionKey = '', customLabel = '', outcome = null) {
      isSystemBusy = busy;
      const allActionButtons = [
        btnRunExtract, btnRunClean, btnRunAudit, btnRunAutopilot, btnRunBuild,
        btnCopyToWindows, btnOpenWindowsExplorer,
        btnPurgeEpub, btnPurgeCache, btnPurgeWorkfiles,
        btnStartOllamaAutopilot, btnHeuristicBatch, btnNextActionCta,
        bookSelector,
        document.getElementById('extractRangeSelect'),
        document.getElementById('extractOcrEngine')
      ];

      const spinnerEl = document.getElementById('liveProgressSpinner');
      const progressBarEl = document.getElementById('liveProgressBar');

      if (busy) {
        allActionButtons.forEach(btn => {
          if (btn) {
            btn.disabled = true;
            btn.classList.add('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
            btn.setAttribute('aria-busy', 'true');
          }
        });

        systemBusySeconds = 0;
        if (liveProgressCard) {
          liveProgressCard.classList.remove('hidden');
          liveProgressTitle.textContent = customLabel || `Trwa: ${actionKey}...`;
          liveProgressSubtitle.textContent = 'Proces CLI w toku w środowisku WSL... Przyciski są zablokowane na czas przetwarzania.';
          liveProgressTimer.textContent = '00:00 s';
        }

        if (spinnerEl) {
          spinnerEl.classList.add('animate-spin');
          spinnerEl.innerHTML = '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>';
        }

        if (progressBarEl) {
          progressBarEl.style.width = '100%';
          progressBarEl.classList.add('animate-pulse');
        }

        if (systemBusyTimer) clearInterval(systemBusyTimer);
        systemBusyTimer = setInterval(() => {
          systemBusySeconds++;
          const mins = String(Math.floor(systemBusySeconds / 60)).padStart(2, '0');
          const secs = String(systemBusySeconds % 60).padStart(2, '0');
          if (liveProgressTimer) liveProgressTimer.textContent = `${mins}:${secs} s`;
        }, 1000);
      } else {
        if (systemBusyTimer) {
          clearInterval(systemBusyTimer);
          systemBusyTimer = null;
        }

        allActionButtons.forEach(btn => {
          if (btn) {
            btn.disabled = false;
            btn.classList.remove('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
            btn.removeAttribute('aria-busy');
          }
        });

        if (spinnerEl) {
          spinnerEl.classList.remove('animate-spin');
        }

        if (outcome === 'success') {
          if (spinnerEl) {
            spinnerEl.innerHTML = '<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
          }
          if (liveProgressTitle) {
            liveProgressTitle.textContent = customLabel ? `✓ ${customLabel}` : '✓ Operacja zakończona sukcesem!';
          }
          if (liveProgressSubtitle) {
            liveProgressSubtitle.textContent = 'Zadanie zostało pomyślnie zrealizowane w WSL. Wszystkie dane są aktualne.';
          }
          if (progressBarEl) {
            progressBarEl.style.width = '100%';
            progressBarEl.classList.remove('animate-pulse');
          }
          setTimeout(() => {
            if (!isSystemBusy && liveProgressCard) {
              liveProgressCard.classList.add('hidden');
            }
          }, 4000);
        } else if (outcome === 'error') {
          if (spinnerEl) {
            spinnerEl.innerHTML = '<svg class="w-5 h-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>';
          }
          if (liveProgressTitle) {
            liveProgressTitle.textContent = customLabel ? `✕ ${customLabel}` : '✕ Wystąpił błąd zadania';
          }
          if (liveProgressSubtitle) {
            liveProgressSubtitle.textContent = 'Proces zakończony z błędem. Sprawdź szczegóły w konsoli CLI poniżej.';
          }
          if (progressBarEl) {
            progressBarEl.classList.remove('animate-pulse');
          }
        } else {
          if (liveProgressCard) {
            liveProgressCard.classList.add('hidden');
          }
        }
      }
    }

    // ----------------------------------------------------
    // SESSION ACTIVITY LOGGING
    // ----------------------------------------------------
    function logSessionActivity(actionName, success, durationMs, details = '') {
      const now = new Date();
      const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      const durStr = durationMs ? `${(durationMs / 1000).toFixed(1)}s` : `${systemBusySeconds}s`;
      sessionActivity.unshift({
        time: timeStr,
        action: actionName,
        success,
        durStr,
        details
      });
      if (sessionActivity.length > 6) sessionActivity.pop();

      renderSessionActivity();
    }

    function renderSessionActivity() {
      if (!sessionActivityList) return;
      if (sessionActivity.length === 0) {
        sessionActivityList.innerHTML = '<div class="text-zinc-500 italic">Brak wcześniejszych operacji w tej sesji.</div>';
        return;
      }

      sessionActivityList.innerHTML = sessionActivity.map(item => {
        const badge = item.success
          ? `<span class="text-emerald-400 font-bold">✓ Sukces (${item.durStr})</span>`
          : `<span class="text-rose-400 font-bold">✕ Błąd (${item.durStr})</span>`;
        return `
          <div class="flex items-center justify-between py-1 border-b border-zinc-800/60 last:border-b-0">
            <div class="flex items-center gap-2 truncate">
              <span class="text-zinc-500 font-mono text-[10px]">${item.time}</span>
              <span class="text-zinc-200 font-medium">${escapeHtml(item.action)}</span>
              ${item.details ? `<span class="text-zinc-500 text-[10px] truncate max-w-xs">(${escapeHtml(item.details)})</span>` : ''}
            </div>
            <div>${badge}</div>
          </div>
        `;
      }).join('');
    }

    // ----------------------------------------------------
    // PIPELINE STEPPER & NEXT BEST ACTION CALCULATOR
    // ----------------------------------------------------
    function updateWorkflowStepper(data) {
      if (!data) return;
      const currentBook = bookSelector.value || 'ksiazka';
      const pdfExists = !!data.pdfInfo?.exists;
      const mdExists = !!data.mdInfo?.exists;
      const mdLines = data.mdInfo?.lines || 0;
      const hasReport = !!data.report;
      const anomaliesCount = (data.report && Array.isArray(data.report.anomalies)) ? data.report.anomalies.length : 0;
      const epubExists = !!data.epubInfo?.exists;
      const isEpubValid = epubExists && mdExists && data.epubInfo?.current !== false;
      const isCleaned = mdExists && Boolean(data.cleanInfo?.cleaned);

      // Usunięcie podświetleń z kart
      [stepCard1, stepCard2, stepCard3, stepCard4, stepCard5].forEach(c => {
        if (c) c.classList.remove('ring-2', 'ring-emerald-400', 'ring-cyan-400', 'ring-amber-400', 'ring-rose-400', 'animate-pulse');
      });

      // Źródło: Wejście PDF
      if (stepCard1) {
        stepCard1.className = pdfExists 
          ? 'bg-emerald-950/20 border border-emerald-500/40 rounded-xl p-3 flex flex-col justify-between transition-all'
          : 'bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 flex flex-col justify-between transition-all';
      }
      if (stepTitle1) stepTitle1.textContent = data.pdfInfo?.filename || `${currentBook}.pdf`;
      if (stepSub1) stepSub1.textContent = pdfExists ? (data.pdfInfo?.size || 'Gotowy') : 'Brak w input/';
      if (stepStatus1) {
        stepStatus1.innerHTML = pdfExists 
          ? '<span class="text-emerald-400 font-medium">✓ Gotowy w input/</span>' 
          : '<span class="text-rose-400 font-medium">✕ Brak pliku</span>';
      }
      if (stepBadge1) {
        stepBadge1.className = pdfExists ? 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-emerald-500/20 text-emerald-300 font-bold' : 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-zinc-800 text-zinc-400';
        stepBadge1.textContent = pdfExists ? '✓ PDF' : 'BRAK';
      }

      // Krok 1: Ekstrakcja Markdown
      if (stepCard2) {
        stepCard2.className = mdExists
          ? 'bg-emerald-950/20 border border-emerald-500/40 rounded-xl p-3 flex flex-col justify-between transition-all'
          : 'bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 flex flex-col justify-between transition-all';
      }
      if (stepTitle2) stepTitle2.textContent = data.mdInfo?.filename || `${currentBook}.md`;
      if (stepSub2) stepSub2.textContent = mdExists ? `${mdLines.toLocaleString()} linii (${data.mdInfo.size})` : (pdfExists ? 'Gotowy do ekstrakcji' : 'Wymaga ekstrakcji');
      if (stepStatus2) {
        stepStatus2.innerHTML = mdExists 
          ? '<span class="text-emerald-400 font-medium">✓ Wyekstrahowano</span>' 
          : (pdfExists ? '<span class="text-amber-400 font-medium">● Gotowy do ekstrakcji</span>' : '<span class="text-zinc-500">Oczekuje na PDF</span>');
      }
      if (stepBadge2) {
        stepBadge2.className = mdExists ? 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-emerald-500/20 text-emerald-300 font-bold' : 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-zinc-800 text-zinc-400';
        stepBadge2.textContent = mdExists ? '✓ MD' : 'DO ZROBIENIA';
      }

      // Krok 2: Czyszczenie tekstu
      if (stepCard3) {
        stepCard3.className = isCleaned
          ? 'bg-emerald-950/20 border border-emerald-500/40 rounded-xl p-3 flex flex-col justify-between transition-all'
          : (mdExists ? 'bg-amber-950/20 border border-amber-500/40 rounded-xl p-3 flex flex-col justify-between transition-all' : 'bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 flex flex-col justify-between transition-all');
      }
      if (stepTitle3) stepTitle3.textContent = 'Czyszczenie tekstu';
      if (stepSub3) stepSub3.textContent = isCleaned ? 'Tekst znormalizowany' : (mdExists ? 'De-hyphen, ułamki, szum' : 'Wymaga Markdowna');
      if (stepStatus3) {
        stepStatus3.innerHTML = isCleaned
          ? '<span class="text-emerald-400 font-medium">✓ Oczyszczony</span>'
          : (mdExists ? '<span class="text-amber-400 font-medium">● Do uruchomienia</span>' : '<span class="text-zinc-500">Oczekuje na Krok 1</span>');
      }
      if (stepBadge3) {
        stepBadge3.className = mdExists ? (isCleaned ? 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-emerald-500/20 text-emerald-300 font-bold' : 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-amber-500/20 text-amber-300 font-bold') : 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-zinc-800 text-zinc-400';
        stepBadge3.textContent = mdExists ? (isCleaned ? '✓ WYKONANO' : 'DOSTĘPNY') : 'OCZEKUJE';
      }

      // Krok 3: Audyt i Naprawa OCR
      if (stepCard4) {
        if (hasReport) {
          stepCard4.className = anomaliesCount === 0
            ? 'bg-emerald-950/20 border border-emerald-500/40 rounded-xl p-3 flex flex-col justify-between transition-all'
            : 'bg-rose-950/20 border border-rose-500/40 rounded-xl p-3 flex flex-col justify-between transition-all';
        } else {
          stepCard4.className = 'bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 flex flex-col justify-between transition-all';
        }
      }
      if (stepTitle4) stepTitle4.textContent = 'Audyt i Naprawa OCR';
      if (stepSub4) {
        stepSub4.textContent = hasReport ? (anomaliesCount === 0 ? '0 wykrytych anomalii' : `${anomaliesCount} wad do naprawy`) : (mdExists ? 'Wymaga audytu' : 'Wymaga Markdowna');
      }
      if (stepStatus4) {
        if (hasReport) {
          stepStatus4.innerHTML = anomaliesCount === 0 
            ? '<span class="text-emerald-400 font-medium">✓ Audyt zakończony</span>'
            : `<span class="text-amber-400 font-medium">⚠ ${anomaliesCount} wad do naprawy</span>`;
        } else {
          stepStatus4.innerHTML = mdExists 
            ? '<span class="text-zinc-400">Do uruchomienia</span>' 
            : '<span class="text-zinc-500">Oczekuje na Krok 1</span>';
        }
      }
      if (stepBadge4) {
        if (hasReport) {
          stepBadge4.className = anomaliesCount === 0 
            ? 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-emerald-500/20 text-emerald-300 font-bold' 
            : 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-rose-500/20 text-rose-300 font-bold';
          stepBadge4.textContent = anomaliesCount === 0 ? '✓ AUDYT' : `${anomaliesCount} WAD`;
        } else {
          stepBadge4.className = 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-zinc-800 text-zinc-400';
          stepBadge4.textContent = 'AUDIT';
        }
      }

      // Krok 4: Publikacja EPUB 3
      if (stepCard5) {
        stepCard5.className = isEpubValid
          ? 'bg-emerald-950/20 border border-emerald-500/40 rounded-xl p-3 flex flex-col justify-between transition-all'
          : 'bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 flex flex-col justify-between transition-all';
      }
      if (stepTitle5) stepTitle5.textContent = isEpubValid ? (data.epubInfo?.filename || `${currentBook}.epub`) : `${currentBook}.epub`;
      if (stepSub5) stepSub5.textContent = isEpubValid ? `${data.epubInfo?.size} (${data.epubInfo?.mtime || 'gotowy'})` : 'Wymaga kompilacji';
      if (stepStatus5) {
        stepStatus5.innerHTML = isEpubValid 
          ? '<span class="text-emerald-400 font-medium">✓ Gotowy do czytania</span>' 
          : '<span class="text-zinc-500">Oczekuje na Krok 3</span>';
      }
      if (stepBadge5) {
        stepBadge5.className = isEpubValid ? 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-emerald-500/20 text-emerald-300 font-bold' : 'text-[10px] px-1.5 py-0.5 rounded font-mono bg-zinc-800 text-zinc-400';
        stepBadge5.textContent = isEpubValid ? '✓ EPUB' : 'EPUB 3';
      }

      // Aktualizacja przycisku Autopilota w głównym pasku akcji
      if (btnRunAutopilot && btnRunAutopilotText) {
        if (anomaliesCount > 0) {
          btnRunAutopilotText.textContent = `Autopilot AI (${anomaliesCount})`;
          btnRunAutopilot.className = 'px-3.5 py-2 bg-purple-600 hover:bg-purple-500 text-white rounded-xl text-xs font-semibold transition flex items-center gap-1.5 shadow-md shadow-purple-900/30 active:scale-95';
        } else {
          btnRunAutopilotText.textContent = 'Autopilot AI';
          btnRunAutopilot.className = 'px-3.5 py-2 bg-zinc-800 hover:bg-zinc-700 text-purple-300 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 border border-zinc-700 active:scale-95 shadow-sm';
        }
      }

      // Wyznaczenie Rekomendowanego Następnego Kroku (Hero Banner CTA):
      let tag = 'Krok 1 z 4';
      let title = '';
      let desc = '';
      let cta = '';
      let actionHandler = null;

      if (!pdfExists && !mdExists) {
        tag = 'Przygotowanie';
        title = 'Umieść plik PDF w katalogu input/';
        desc = `Nie znaleziono pliku ${currentBook}.pdf w katalogu input/. Umieść plik PDF, aby rozpocząć proces publikacji.`;
        cta = 'Otwórz Folder Aplikacji';
        actionHandler = () => openWindowsExplorer('input');
        if (stepCard1) stepCard1.classList.add('ring-2', 'ring-rose-400', 'animate-pulse');
      } else if (pdfExists && !mdExists) {
        tag = 'Krok 1 z 4 (Rozpocznij tutaj)';
        title = 'Krok 1: Wyekstrahuj PDF do surowego Markdowna';
        desc = `Znaleziono plik ${data.pdfInfo?.filename || 'PDF'} (${data.pdfInfo?.size || ''}). Odczytaj strukturę i układ kolumn do pliku Markdown.`;
        cta = 'Ekstrahuj z PDF';
        actionHandler = () => triggerAction('extract');
        if (stepCard2) stepCard2.classList.add('ring-2', 'ring-emerald-400', 'animate-pulse');
      } else if (mdExists && !isCleaned) {
        tag = 'Krok 2 z 4 (Zalecany)';
        title = 'Krok 2: Wyczyść i znormalizuj tekst';
        desc = `Plik Markdown istnieje (${mdLines.toLocaleString()} linii). Usuń rozbicia wyrazów (de-hyphenation), ułamki 1/2, szum skanera.`;
        cta = 'Wyczyść Tekst';
        actionHandler = () => triggerAction('clean');
        if (stepCard3) stepCard3.classList.add('ring-2', 'ring-amber-400', 'animate-pulse');
      } else if (mdExists && isCleaned && !hasReport) {
        tag = 'Krok 3 z 4 (Zalecany)';
        title = 'Krok 3: Uruchom Audyt jakościowy OCR';
        desc = `Tekst został oczyszczony. Przeskanuj go pod kątem pozostałych anomalii OCR i uszkodzeń słów.`;
        cta = 'Uruchom Audyt';
        actionHandler = () => triggerAction('audit');
        if (stepCard4) stepCard4.classList.add('ring-2', 'ring-cyan-400', 'animate-pulse');
      } else if (mdExists && hasReport && anomaliesCount > 0) {
        tag = 'Krok 3 z 4 (Naprawa)';
        title = `Krok 3: Uruchom Autopilot Naprawczy (${anomaliesCount} usterek)`;
        desc = `Wykryto ${anomaliesCount} anomalii OCR. Uruchom Autopilota AI lub Szybką Rekonstrukcję, aby nanieść poprawki.`;
        cta = 'Uruchom Autopilot Naprawczy';
        actionHandler = () => startOllamaAutopilot();
        if (stepCard4) stepCard4.classList.add('ring-2', 'ring-purple-400', 'animate-pulse');
      } else if (mdExists && !isEpubValid) {
        tag = 'Krok 4 z 4 (Zalecany)';
        title = 'Krok 4: Skompiluj gotowy e-book EPUB 3';
        desc = 'Audyt nie wykrył anomalii. Możesz skompilować EPUB; poprawność i kompletność treści wymagają porównania z PDF.';
        cta = 'Kompiluj EPUB 3';
        actionHandler = () => triggerAction('build');
        if (stepCard5) stepCard5.classList.add('ring-2', 'ring-emerald-400', 'animate-pulse');
      } else if (isEpubValid) {
        tag = 'Sukces (Publikacja Gotowa)';
        title = 'Publikacja EPUB 3 jest gotowa do czytania!';
        desc = `Plik ${data.epubInfo?.filename || 'ksiazka.epub'} (${data.epubInfo?.size || ''}) został wygenerowany z bieżącego Markdowna.`;
        cta = 'Kopiuj do Windows Pobrane';
        actionHandler = () => copyToWindowsDownloads();
        if (stepCard5) stepCard5.classList.add('ring-2', 'ring-emerald-400');
      }

      if (nextActionStepTag) nextActionStepTag.textContent = tag;
      if (nextActionTitle) nextActionTitle.textContent = title;
      if (nextActionDescription) nextActionDescription.textContent = desc;
      if (nextActionCtaText) nextActionCtaText.textContent = cta;
      activeCtaHandler = actionHandler;

      if (stepperGlobalStatus) {
        stepperGlobalStatus.textContent = isEpubValid && isCleaned && hasReport && anomaliesCount === 0
          ? '✓ E-book gotowy' 
          : mdExists 
            ? (hasReport ? (anomaliesCount === 0 ? '✓ Brak wykrytych anomalii' : `Wykryto ${anomaliesCount} wad`) : 'Krok 1 ukończony (MD gotowy)')
            : (pdfExists ? 'Krok 1: Gotowy do ekstrakcji' : 'Oczekiwanie na plik PDF');
      }
    }

    // Wywołanie akcji w CLI (extract, clean, audit, build) z ochroną przed współbieżnością i guardrailami
    async function triggerAction(actionName) {
      if (isSystemBusy) {
        showToast('Inna operacja jest w toku. Zaczekaj na jej zakończenie.', 'warning');
        return false;
      }
      if (activeRepairController) {
        showToast('Trwa naprawa akapitu. Zaczekaj lub zatrzymaj Autopilota.', 'info');
        return false;
      }

      const currentBook = bookSelector.value || 'ksiazka';

      // Guardrail: Ostrzeżenie przed długim czasem przetwarzania pełnej książki (914 stron)
      if (actionName === 'extract') {
        const rangeSelect = document.getElementById('extractRangeSelect');
        if (rangeSelect && rangeSelect.value === 'all') {
          showConfirmModal({
            title: 'Pełna ekstrakcja 914 stron z OCR',
            message: `Wybrano przetwarzanie całej książki (wszystkie 914 stron) z silnikiem OCR.\n\nOperacja na 914 stronach zajmie około 20-30 minut w tle w WSL.\n\nCzy na pewno chcesz kontynuować pełny przebieg, czy wolisz szybki test (strony 1-25)?`,
            confirmText: 'Kontynuuj pełne 914 stron',
            danger: false,
            onConfirm: async () => {
              await executeAction(actionName, currentBook);
            }
          });
          return false;
        }
      }

      // Guardrail: Ostrzeżenie przed nadpisaniem istniejącego pliku Markdown
      if (actionName === 'extract' && globalStatusData?.mdInfo?.exists && globalStatusData.mdInfo.lines > 10) {
        showConfirmModal({
          title: 'Ostrzeżenie przed nadpisaniem Markdowna',
          message: `Plik "${currentBook}.md" (${globalStatusData.mdInfo.lines.toLocaleString()} linii) już istnieje i może zawierać naniesione poprawki.\n\nPonowna ekstrakcja z PDF całkowicie nadpisze ten plik surową zawartością z OCR.\n\nCzy na pewno chcesz wygenerować Markdown od nowa?`,
          confirmText: 'Nadpisz i wyekstrahuj',
          danger: true,
          onConfirm: async () => {
            await executeAction(actionName, currentBook);
          }
        });
        return false;
      }

      return await executeAction(actionName, currentBook);
    }

    async function executeAction(actionName, currentBook) {
      const actionLabels = {
        extract: 'Ekstrakcja układu i tekstu z PDF',
        clean: 'Czyszczenie de-hyphenation i ułamków',
        audit: 'Audyt jakościowy OCR i detekcja wad',
        build: 'Kompilacja e-booka EPUB 3 przez Pandoc',
        purge: 'Czyszczenie plików roboczych',
        'purge-epub': 'Usuwanie pliku EPUB',
        'purge-all': 'Pełne czyszczenie wyjściowe',
        'purge-temp': 'Czyszczenie pamięci podręcznej i śmieci'
      };

      const label = actionLabels[actionName] || actionName;
      setSystemBusy(true, actionName, label);
      showStatus(`Wykonywanie: ${label}...`, 'info');

      if (liveTerminalDrawer) {
        liveTerminalDrawer.classList.remove('hidden');
      }
      if (liveConsoleOutput) {
        liveConsoleOutput.textContent = `[${new Date().toLocaleTimeString()}] ▶ Uruchamianie: ${label}...\n`;
      }

      let bodyData = { action: actionName, book: currentBook };
      let progressTimer = null;

      if (actionName === 'extract') {
        const rangeSelect = document.getElementById('extractRangeSelect');
        const customInput = document.getElementById('extractCustomPages');
        const engineSelect = document.getElementById('extractOcrEngine');

        let pagesVal = '';
        if (rangeSelect) {
          if (rangeSelect.value === 'custom' && customInput) {
            pagesVal = customInput.value.trim();
          } else if (rangeSelect.value !== 'all') {
            pagesVal = rangeSelect.value;
          }
        }
        const ocrEngineVal = engineSelect ? engineSelect.value : 'rapidocr';
        bodyData.pages = pagesVal;
        bodyData.ocrEngine = ocrEngineVal;
        if (ocrEngineVal === 'native') {
          bodyData.ocrMode = 'native';
        }

        // Odpytywanie postępu ekstrakcji w czasie rzeczywistym
        progressTimer = setInterval(async () => {
          try {
            const stRes = await fetch(`/api/status?book=${encodeURIComponent(currentBook)}`);
            const stData = await stRes.json();
            if (stData.extractProgress && stData.extractProgress.status === 'running') {
              const p = stData.extractProgress;
              const titleEl = document.getElementById('liveProgressTitle');
              const barEl = document.getElementById('liveProgressBar');
              if (titleEl && p.total_pages) {
                titleEl.textContent = `Ekstrakcja: strona ${p.current_page}/${p.total_pages} (${p.percent}%)`;
              }
              if (barEl && p.percent) {
                barEl.style.width = `${p.percent}%`;
              }
            }
          } catch (e) {}
        }, 1200);
      }

      let actionSuccess = false;
      let actionError = null;
      let durationMs = 0;

      if (activeAbortController) {
        try { activeAbortController.abort(); } catch {}
      }
      activeAbortController = new AbortController();

      try {
        const res = await fetch('/api/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...bodyData, stream: true }),
          signal: activeAbortController.signal
        });

        const contentType = res.headers.get('content-type') || '';

        if (contentType.includes('application/x-ndjson') && res.body) {
          const reader = res.body.getReader();
          const decoder = new TextDecoder('utf-8');
          let buffer = '';

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop() || '';

            for (const line of lines) {
              if (!line.trim()) continue;
              try {
                const event = JSON.parse(line);
                if (event.type === 'stdout' || event.type === 'stderr') {
                  if (liveConsoleOutput) {
                    const cleanText = event.text.replace(/\x1b\[[0-9;]*[a-zA-Z]/g, '');
                    liveConsoleOutput.textContent += cleanText;
                    liveConsoleOutput.scrollTop = liveConsoleOutput.scrollHeight;
                  }
                  const match = event.text.match(/strona\s+(\d+)\s+\(ukończono\s+(\d+)\/(\d+)\s+-\s+([\d\.]+)%\)/i);
                  if (match) {
                    const [, curr, comp, total, pct] = match;
                    if (liveProgressTitle) liveProgressTitle.textContent = `Ekstrakcja: strona ${curr}/${total} (${pct}%)`;
                    if (liveProgressBar) liveProgressBar.style.width = `${pct}%`;
                  }
                } else if (event.type === 'done') {
                  actionSuccess = event.success;
                  actionError = event.error;
                  durationMs = event.durationMs;
                } else if (event.type === 'error') {
                  actionSuccess = false;
                  actionError = event.error;
                }
              } catch (parseErr) {}
            }
          }
        } else {
          const data = await res.json();
          actionSuccess = data.success;
          actionError = data.error;
          durationMs = data.durationMs || (systemBusySeconds * 1000);
          if (data.stdout || data.stderr) {
            if (liveConsoleOutput) {
              const fullText = [data.stdout, data.stderr].filter(Boolean).join('\n') || '';
              liveConsoleOutput.textContent += fullText.replace(/\x1b\[[0-9;]*[a-zA-Z]/g, '');
              liveConsoleOutput.scrollTop = liveConsoleOutput.scrollHeight;
            }
          }
        }

        if (actionSuccess) {
          const timeSec = (durationMs / 1000).toFixed(1);
          showToast(`✓ ${label} — zakończono sukcesem! (${timeSec}s)`, 'success');
          showStatus(`✓ Akcja "${label}" ukończona pomyślnie (${timeSec}s).`, 'success');
          logSessionActivity(label, true, durationMs, `${currentBook}`);
          await fetchStatus();
          await loadBooks();
          return true;
        } else {
          const errText = actionError || 'Wystąpił błąd podczas wykonywania zadania.';
          showToast(`Błąd: ${errText}`, 'error');
          showStatus(`Błąd akcji "${label}": ${errText}`, 'error');
          logSessionActivity(label, false, durationMs, errText);
          return false;
        }
      } catch (err) {
        if (err.name === 'AbortError') {
          showStatus(`Operacja "${label}" została przerwana.`, 'warning');
          return false;
        }
        showToast(`Błąd sieci: ${err.message}`, 'error');
        showStatus(`Błąd komunikacji: ${err.message}`, 'error');
        logSessionActivity(label, false, 0, err.message);
        return false;
      } finally {
        activeAbortController = null;
        if (progressTimer) clearInterval(progressTimer);
        setSystemBusy(false, actionName, label, actionSuccess ? 'success' : 'error');
      }
    }

    async function cancelActiveJob() {
      const currentBook = bookSelector.value || 'ksiazka';
      if (activeAbortController) {
        try { activeAbortController.abort(); } catch {}
        activeAbortController = null;
      }
      setSystemBusy(false, 'cancel', 'Operacja anulowana', 'error');
      showToast('Przerwano operację.', 'info');
      showStatus('Operacja została przerwana na żądanie użytkownika.', 'warning');
      try {
        const res = await fetch('/api/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'cancel', book: currentBook })
        });
        const data = await res.json();
        await fetchStatus();
      } catch (err) {
        showToast(`Błąd anulowania: ${err.message}`, 'error');
      }
    }

    function showStatus(text, type = 'info') {
      if (liveProgressSubtitle) {
        liveProgressSubtitle.textContent = text;
      }
      if (pipelineStatusBanner && pipelineStatusText) {
        pipelineStatusBanner.classList.remove('hidden', 'bg-emerald-950/40', 'border-emerald-500/40', 'text-emerald-300', 'bg-rose-950/40', 'border-rose-500/40', 'text-rose-300', 'bg-zinc-900', 'border-zinc-700', 'text-zinc-300');
        if (type === 'success') {
          pipelineStatusBanner.classList.add('bg-emerald-950/40', 'border-emerald-500/40', 'text-emerald-300');
        } else if (type === 'error') {
          pipelineStatusBanner.classList.add('bg-rose-950/40', 'border-rose-500/40', 'text-rose-300');
        } else {
          pipelineStatusBanner.classList.add('bg-zinc-900', 'border-zinc-700', 'text-zinc-300');
        }
        pipelineStatusText.textContent = text;
      }
    }

    function copyAgentPrompt() {
      const currentBook = bookSelector.value || 'ksiazka';
      const promptText = `Jesteś Agentem AI w projekcie pdf-to-epub pracującym w VS Code pod WSL/Windows.
Pracujemy nad książką: "${currentBook}".
W pliku output/markdown/${currentBook}.md wykryto uszkodzenia OCR.
Instrukcja postępowania (zgodnie z AGENTS.md):
1. Zbadaj anomalię: uv run python -m src.pipeline inspect-anomaly <INDEX>
2. Zastosuj zrekonstruowany tekst: uv run python -m src.pipeline patch <INDEX> --text "..."
3. Uruchom ponowny audyt: uv run python -m src.pipeline audit --book ${currentBook}
4. Po weryfikacji skompiluj EPUB: uv run python -m src.pipeline build --book ${currentBook}
Plik wynikowy trafi do: output/epub/${currentBook}.epub oraz do folderu Pobrane w Windows.`;

      copyToClipboard(promptText, '✓ Skopiowano prompt dla Agenta VS Code do schowka!');
    }

    function setupEventListeners() {
      bookSelector.addEventListener('change', () => fetchStatus());

      severityFilter.addEventListener('change', (e) => {
        activeFilter = e.target.value;
        renderAnomalies();
      });

      anomalySearch.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderAnomalies();
      });

      btnNextActionCta?.addEventListener('click', () => {
        if (activeCtaHandler) activeCtaHandler();
      });

      btnToggleTerminalOutput?.addEventListener('click', () => {
        if (liveTerminalDrawer) {
          liveTerminalDrawer.classList.toggle('hidden');
        }
      });

      document.getElementById('btnCancelActiveJob')?.addEventListener('click', cancelActiveJob);

      btnRunExtract.addEventListener('click', () => triggerAction('extract'));
      btnRunClean.addEventListener('click', () => triggerAction('clean'));
      btnRunAudit.addEventListener('click', () => triggerAction('audit'));
      btnRunAutopilot?.addEventListener('click', () => {
        const anomalies = globalReport?.anomalies || [];
        if (anomalies.length === 0) {
          showToast('Brak wad do naprawy w pliku audytu.', 'info');
        } else {
          startOllamaAutopilot();
        }
      });
      btnRunBuild.addEventListener('click', () => triggerAction('build'));

      btnCopyToWindows.addEventListener('click', copyToWindowsDownloads);
      btnOpenWindowsExplorer.addEventListener('click', () => openWindowsExplorer('output'));
      btnPurgeEpub.addEventListener('click', purgeEpubOnly);
      btnPurgeCache?.addEventListener('click', purgeCacheOnly);
      btnPurgeWorkfiles.addEventListener('click', purgeWorkingFiles);
      ollamaBadge.addEventListener('click', showOllamaHelp);

      btnStartOllamaAutopilot.addEventListener('click', startOllamaAutopilot);
      btnHeuristicBatch.addEventListener('click', runHeuristicBatch);
      btnCopyAgentPrompt.addEventListener('click', copyAgentPrompt);
      document.getElementById('btnShowQualityInfo').addEventListener('click', openQualityModal);

      btnStopAutopilot.addEventListener('click', () => {
        stopRequested = true;
        activeRepairController?.abort();
        autopilotStepLabel.textContent = 'Zatrzymywanie autopilota...';
      });

      // Modale
      document.getElementById('btnCloseOllamaModal').addEventListener('click', closeOllamaModal);
      document.getElementById('btnCloseOllamaModalBottom').addEventListener('click', closeOllamaModal);
      document.getElementById('btnCloseQualityModal').addEventListener('click', closeQualityModal);
      document.getElementById('btnCloseQualityModalBottom').addEventListener('click', closeQualityModal);

      document.getElementById('btnCheckOllamaAgain').addEventListener('click', async () => {
        const btn = document.getElementById('btnCheckOllamaAgain');
        btn.disabled = true;
        btn.innerHTML = `<svg class="animate-spin w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg> Sprawdzanie...`;
        
        showToast('Sprawdzanie połączenia z serwerem Ollama...', 'info');
        await fetchStatus();
        
        btn.disabled = false;
        btn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg> Sprawdź połączenie`;

        const statusBox = document.getElementById('modalOllamaStatusBox');
        if (globalOllama && globalOllama.available) {
          if (statusBox) {
            statusBox.className = 'p-3.5 rounded-xl text-xs font-mono border bg-emerald-500/10 border-emerald-500/30 text-emerald-300 flex items-start gap-2.5';
            statusBox.innerHTML = `
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <div>
                <span class="font-bold">✓ Ollama jest połączona i gotowa do pracy!</span>
                <p class="mt-1 text-zinc-300 font-sans leading-relaxed">
                  Wykryte modele na RTX 4080: <strong>${(globalOllama.models || []).join(', ') || 'qwen2.5:14b'}</strong>.
                </p>
              </div>
            `;
          }
          showToast('✓ Połączono z Ollama na RTX 4080 Super!', 'success');
        } else {
          if (statusBox) {
            statusBox.className = 'p-3.5 rounded-xl text-xs font-mono border bg-amber-500/10 border-amber-500/30 text-amber-300 flex items-start gap-2.5';
            statusBox.innerHTML = `
              <svg class="w-4 h-4 mt-0.5 shrink-0 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <div>
                <span class="font-bold">Ollama nadal nie odpowiada.</span>
                <p class="mt-1 text-zinc-300 font-sans leading-relaxed">
                  Upewnij się, że wykonano polecenie PowerShell i zrestartowano aplikację Ollama w Windows.
                </p>
              </div>
            `;
          }
          showToast('Ollama nadal offline. Upewnij się, że zrestartowano Ollama w Windows.', 'warning');
        }
      });

      document.getElementById('btnCancelConfirm').addEventListener('click', closeConfirmModal);
      document.getElementById('btnAcceptConfirm').addEventListener('click', async () => {
        if (pendingConfirmAction) {
          const action = pendingConfirmAction;
          closeConfirmModal();
          await action();
        }
      });

      // Scan Viewer Modal Listeners
      const btnModalClose = document.getElementById('btnModalClose');
      const btnModalPrevPage = document.getElementById('btnModalPrevPage');
      const btnModalNextPage = document.getElementById('btnModalNextPage');
      const btnModalZoomIn = document.getElementById('btnModalZoomIn');
      const btnModalZoomOut = document.getElementById('btnModalZoomOut');
      const btnModalZoomFit = document.getElementById('btnModalZoomFit');

      if (btnModalClose) btnModalClose.addEventListener('click', closeScanViewer);
      if (btnModalPrevPage) btnModalPrevPage.addEventListener('click', () => stepModalPage(-1));
      if (btnModalNextPage) btnModalNextPage.addEventListener('click', () => stepModalPage(1));
      if (btnModalZoomIn) btnModalZoomIn.addEventListener('click', () => setModalZoom(modalCurrentZoom + 0.25));
      if (btnModalZoomOut) btnModalZoomOut.addEventListener('click', () => setModalZoom(modalCurrentZoom - 0.25));
      if (btnModalZoomFit) btnModalZoomFit.addEventListener('click', () => setModalZoom(1.0));

      const extractRangeSelect = document.getElementById('extractRangeSelect');
      const extractCustomPages = document.getElementById('extractCustomPages');
      if (extractRangeSelect && extractCustomPages) {
        extractRangeSelect.addEventListener('change', () => {
          if (extractRangeSelect.value === 'custom') {
            extractCustomPages.classList.remove('hidden');
            extractCustomPages.focus();
          } else {
            extractCustomPages.classList.add('hidden');
          }
        });
      }

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeScanViewer();
        }
      });
    }

    // Start
    init();
  </script>
</body>
</html>
