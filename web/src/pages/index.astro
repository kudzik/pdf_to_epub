---
// PDF to EPUB Studio - Astro SSR Page
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="pl" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PDF to EPUB Studio - Panel Inspekcji i Naprawy</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2310b981'><path d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'/></svg>" />
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col selection:bg-emerald-500/30 selection:text-emerald-300">
  <!-- Top Navigation Bar -->
  <header class="border-b border-zinc-800/80 bg-zinc-900/60 backdrop-blur sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <h1 class="font-bold text-lg leading-tight tracking-tight text-white flex items-center gap-2">
            PDF to EPUB Studio
            <span class="text-xs font-mono font-medium px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300 border border-zinc-700">WSL/Windows</span>
            <span class="text-[11px] font-mono font-medium px-2 py-0.5 rounded-full bg-emerald-950/80 text-emerald-300 border border-emerald-700/60 flex items-center gap-1.5" title="Strumieniowanie konsoli CLI w czasie rzeczywistym aktywne"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>Live v2.1</span>
          </h1>
          <p class="text-xs text-zinc-400">Książki kucharskie &middot; OCR &middot; Markdown &middot; EPUB 3</p>
        </div>
      </div>

      <!-- Book Selector, WSL Actions & AI Engine Pill -->
      <div class="flex items-center gap-3">
        <!-- Wybór książki -->
        <div class="flex items-center gap-2 bg-zinc-900 border border-zinc-700/80 rounded-lg px-3 py-1.5 text-sm">
          <span class="text-xs text-zinc-400 font-medium">Książka:</span>
          <select id="bookSelector" class="bg-transparent text-emerald-400 font-mono font-medium focus:outline-none cursor-pointer">
            <option value="ksiazka" class="bg-zinc-900 text-zinc-100">ksiazka</option>
          </select>
        </div>

        <div id="ollamaBadge" class="flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs font-mono transition-all cursor-pointer hover:border-zinc-500" title="Kliknij, aby sprawdzić instrukcję połączenia z Ollama na Windows">
          <span class="relative flex h-2 w-2">
            <span id="ollamaPing" class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"></span>
            <span id="ollamaDot" class="relative inline-flex rounded-full h-2 w-2"></span>
          </span>
          <span id="ollamaText">Sprawdzanie Ollama...</span>
        </div>

        <div class="hidden sm:flex items-center gap-1.5 text-xs text-zinc-500 font-mono bg-zinc-900/40 px-2.5 py-1.5 rounded border border-zinc-800">
          <span>PORT:</span>
          <span class="text-zinc-300 font-semibold">4343</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full space-y-6">
    
    <!-- Top Action Banner & Quick Metrics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <!-- Metric 1: Plik Markdown -->
      <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-400 text-xs font-medium uppercase tracking-wider mb-2">
          <span>Źródło Markdown (.md)</span>
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="statMdLines" class="text-2xl font-bold font-mono text-zinc-100">---</span>
          <span class="text-xs text-zinc-400">linii tekstu</span>
        </div>
        <div class="mt-2 text-xs text-zinc-400 flex items-center justify-between">
          <span id="statMdSize">Rozmiar: -- MB</span>
          <span id="statMdStatus" class="text-emerald-400 font-medium">Dostępny</span>
        </div>
      </div>

      <!-- Metric 2: Anomalie OCR -->
      <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-400 text-xs font-medium uppercase tracking-wider mb-2">
          <span>Wykryte Anomalie</span>
          <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="statAnomalyTotal" class="text-2xl font-bold font-mono text-rose-400">---</span>
          <span class="text-xs text-zinc-400">do poprawy</span>
        </div>
        <div class="mt-2 text-xs flex items-center gap-2 font-mono">
          <span class="text-rose-400 font-medium" id="statHighBadge">High: --</span>
          <span class="text-zinc-600">&middot;</span>
          <span class="text-amber-400 font-medium" id="statMedBadge">Med: --</span>
          <span class="text-zinc-600">&middot;</span>
          <span class="text-zinc-400" id="statLowBadge">Low: --</span>
        </div>
      </div>

      <!-- Metric 3: Kompilacja EPUB -->
      <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-400 text-xs font-medium uppercase tracking-wider mb-2">
          <span>Kompilacja EPUB 3 (.epub)</span>
          <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="statEpubSize" class="text-2xl font-bold font-mono text-zinc-100">---</span>
          <span id="statEpubLabel" class="text-xs text-zinc-400">gotowy</span>
        </div>
        <div class="mt-2 text-xs flex items-center justify-between">
          <span id="statEpubTime" class="text-zinc-400">Zaktualizowano: --</span>
          <a id="btnDownloadEpub" href="/api/download" class="text-indigo-400 hover:text-indigo-300 font-medium hover:underline flex items-center gap-1">
            Pobierz &darr;
          </a>
        </div>
      </div>

      <!-- Metric 4: AI & Sprzęt (RTX 4080 Super) -->
      <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-400 text-xs font-medium uppercase tracking-wider mb-2">
          <span>Akceleracja AI</span>
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="statGpuLabel" class="text-lg font-bold font-mono text-emerald-400">RTX 4080 S</span>
          <span class="text-xs text-zinc-400 font-mono">16GB VRAM</span>
        </div>
        <div class="mt-2 text-xs text-zinc-400 flex items-center justify-between">
          <span id="statModelName">Model: Qwen 2.5 / VS Code</span>
          <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">0 PLN API</span>
        </div>
      </div>
    </div>

    <!-- 1. HERO: REKOMENDOWANY KOLEJNY KROK (Next Best Action CTA) -->
    <div id="nextActionHeroBanner" class="relative overflow-hidden bg-gradient-to-r from-emerald-950/40 via-zinc-900 to-cyan-950/30 border border-emerald-500/40 rounded-2xl p-4 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5">
        <div id="nextActionIconContainer" class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0 mt-0.5">
          <svg class="w-5 h-5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="text-[11px] font-mono uppercase tracking-wider text-emerald-400 font-bold bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">Zalecana kolejna akcja</span>
            <span id="nextActionStepTag" class="text-xs text-zinc-400 font-mono">Krok 1 z 4</span>
          </div>
          <h2 id="nextActionTitle" class="text-base font-bold text-white tracking-tight">Krok 1: Wyekstrahuj PDF do Markdown</h2>
          <p id="nextActionDescription" class="text-xs text-zinc-400 leading-relaxed max-w-2xl">
            Znaleziono plik PDF w katalogu input/. Kliknij, aby wygenerować źródłowy plik Markdown i wyodrębnić ilustracje.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 w-full md:w-auto justify-end">
        <button id="btnNextActionCta" class="w-full md:w-auto px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/20 active:scale-95">
          <span id="nextActionCtaText">Uruchom Zalecany Krok</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </button>
      </div>
    </div>

    <!-- 2. WIZUALNY STEPPER PROCESU (Pipeline Workflow Stepper) -->
    <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 shadow-sm space-y-3">
      <div class="flex items-center justify-between text-xs border-b border-zinc-800/80 pb-2.5">
        <span class="font-bold text-zinc-300 uppercase tracking-wider text-[11px] flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          Etapy Publikacji E-booka
        </span>
        <span id="stepperGlobalStatus" class="font-mono text-zinc-400 text-[11px]">Ładowanie stanu książki...</span>
      </div>

      <!-- 5-kolumnowy grid etapów (4 Etapy Procesu + Źródło) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <!-- Step 1: Input PDF (Źródło) -->
        <div id="stepCard1" class="bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 flex flex-col justify-between transition-all">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono font-bold uppercase text-zinc-400">Źródło</span>
            <span id="stepBadge1" class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-zinc-800 text-zinc-400">PDF</span>
          </div>
          <div class="my-2">
            <div id="stepTitle1" class="text-xs font-bold text-zinc-200">Plik PDF</div>
            <div id="stepSub1" class="text-[11px] text-zinc-400 font-mono truncate">Sprawdzanie...</div>
          </div>
          <div id="stepStatus1" class="text-[10px] text-zinc-400 flex items-center gap-1">
            <span>● Status: --</span>
          </div>
        </div>

        <!-- Step 2: Ekstrakcja MD (Krok 1) -->
        <div id="stepCard2" class="bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 flex flex-col justify-between transition-all">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono font-bold uppercase text-zinc-400">Krok 1</span>
            <span id="stepBadge2" class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-zinc-800 text-zinc-400">MD</span>
          </div>
          <div class="my-2">
            <div id="stepTitle2" class="text-xs font-bold text-zinc-200">Ekstrakcja Markdown</div>
            <div id="stepSub2" class="text-[11px] text-zinc-400 font-mono truncate">Sprawdzanie...</div>
          </div>
          <div id="stepStatus2" class="text-[10px] text-zinc-400 flex items-center gap-1">
            <span>● Status: --</span>
          </div>
        </div>

        <!-- Step 3: Czyszczenie tekstu (Krok 2) -->
        <div id="stepCard3" class="bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 flex flex-col justify-between transition-all">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono font-bold uppercase text-zinc-400">Krok 2</span>
            <span id="stepBadge3" class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-zinc-800 text-zinc-400">CLEAN</span>
          </div>
          <div class="my-2">
            <div id="stepTitle3" class="text-xs font-bold text-zinc-200">Czyszczenie tekstu</div>
            <div id="stepSub3" class="text-[11px] text-zinc-400 font-mono truncate">De-hyphen, ułamki, szum</div>
          </div>
          <div id="stepStatus3" class="text-[10px] text-zinc-400 flex items-center gap-1">
            <span>● Status: --</span>
          </div>
        </div>

        <!-- Step 4: Audyt i Naprawa OCR (Krok 3) -->
        <div id="stepCard4" class="bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 flex flex-col justify-between transition-all">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono font-bold uppercase text-zinc-400">Krok 3</span>
            <span id="stepBadge4" class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-zinc-800 text-zinc-400">AUDIT</span>
          </div>
          <div class="my-2">
            <div id="stepTitle4" class="text-xs font-bold text-zinc-200">Audyt i Naprawa OCR</div>
            <div id="stepSub4" class="text-[11px] text-zinc-400 font-mono truncate">Weryfikacja wad</div>
          </div>
          <div id="stepStatus4" class="text-[10px] text-zinc-400 flex items-center gap-1">
            <span>● Status: --</span>
          </div>
        </div>

        <!-- Step 5: EPUB 3 (Krok 4) -->
        <div id="stepCard5" class="bg-zinc-950/60 border border-zinc-800 rounded-xl p-3 flex flex-col justify-between transition-all">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono font-bold uppercase text-zinc-400">Krok 4</span>
            <span id="stepBadge5" class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-zinc-800 text-zinc-400">EPUB 3</span>
          </div>
          <div class="my-2">
            <div id="stepTitle5" class="text-xs font-bold text-zinc-200">Publikacja EPUB 3</div>
            <div id="stepSub5" class="text-[11px] text-zinc-400 font-mono truncate">Sprawdzanie...</div>
          </div>
          <div id="stepStatus5" class="text-[10px] text-zinc-400 flex items-center gap-1">
            <span>● Status: --</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. ZREORGANIZOWANY PASEK AKCJI (Główne etapy + Narzędzia + Strefa Bezpieczeństwa) -->
    <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 space-y-4">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
        <!-- Grupa 1: Główne etapy potoku -->
        <div class="space-y-1.5">
          <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            Główne Kroki Pipeline'u (Kolejność 1 ➔ 4; Autopilot w kroku 3):
          </span>
          <div class="flex flex-wrap items-center gap-2">
            <!-- Rozszerzony Krok 1 z wyborem zakresu stron i silnika OCR -->
            <div class="flex items-center rounded-xl bg-zinc-800/80 border border-zinc-700 p-0.5 shadow-sm">
              <button id="btnRunExtract" class="px-3 py-1.5 hover:bg-zinc-700 text-cyan-300 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 active:scale-95" title="Krok 1: Wyekstrahuj PDF do czystego Markdowna">
                <span class="w-4 h-4 rounded-full bg-cyan-500/20 text-cyan-400 border border-cyan-500/40 flex items-center justify-center text-[10px] font-bold">1</span>
                <span>Ekstrahuj z PDF</span>
              </button>
              <div class="h-4 w-px bg-zinc-700 mx-1"></div>
              <select id="extractRangeSelect" class="bg-transparent text-cyan-200 text-[11px] font-mono focus:outline-none pr-1 cursor-pointer" title="Zakres stron do ekstrakcji">
                <option value="1-10" selected>Strony 1-10 (Szybki test ~15s)</option>
                <option value="1-25">Strony 1-25 (Wstęp)</option>
                <option value="all">Pełna książka (1-914)</option>
                <option value="custom">Własny zakres...</option>
              </select>
              <input id="extractCustomPages" type="text" placeholder="np. 20-30" class="w-20 bg-zinc-950 border border-zinc-700 rounded px-1.5 py-0.5 text-[11px] font-mono text-white hidden ml-1" title="Podaj zakres stron, np. 20-30 lub 5" />
            </div>

            <select id="extractOcrEngine" class="bg-zinc-800/80 border border-zinc-700 text-zinc-300 text-[11px] font-mono rounded-xl px-2 py-2 focus:outline-none cursor-pointer" title="Silnik OCR do użycia przy ekstrakcji">
              <option value="rapidocr" selected>⚡ RapidOCR (Szybki, zalecany)</option>
              <option value="auto">Auto (detekcja jakości)</option>
              <option value="native">Tylko warstwa tekstowa PDF</option>
              <option value="easyocr">EasyOCR</option>
            </select>

            <button id="btnRunClean" class="px-3.5 py-2 bg-zinc-800 hover:bg-zinc-700 text-amber-300 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 border border-zinc-700 active:scale-95 shadow-sm" title="Krok 2: Rekonstrukcja polskich znaków, ułamków i de-hyphenation">
              <span class="w-4 h-4 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/40 flex items-center justify-center text-[10px] font-bold">2</span>
              <span>Wyczyść Tekst</span>
            </button>
            <button id="btnRunAudit" class="px-3.5 py-2 bg-zinc-800 hover:bg-zinc-700 text-rose-300 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 border border-zinc-700 active:scale-95 shadow-sm" title="Krok 3: Sprawdź tekst pod kątem uszkodzeń OCR">
              <span class="w-4 h-4 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/40 flex items-center justify-center text-[10px] font-bold">3</span>
              <span>Uruchom Audyt</span>
            </button>
            <button id="btnRunAutopilot" class="px-3.5 py-2 bg-zinc-800 hover:bg-zinc-700 text-purple-300 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 border border-zinc-700 active:scale-95 shadow-sm" title="Krok 3: Uruchom Autopilota AI do automatycznej naprawy wad">
              <span class="w-4 h-4 rounded-full bg-purple-500/20 text-purple-400 border border-purple-500/40 flex items-center justify-center text-[10px] font-bold">3</span>
              <span id="btnRunAutopilotText">Autopilot AI</span>
            </button>
            <button id="btnRunBuild" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-md shadow-emerald-900/30 active:scale-95" title="Krok 4: Kompiluj Markdown do EPUB 3 przez Pandoc">
              <span class="w-4 h-4 rounded-full bg-white/20 text-white border border-white/40 flex items-center justify-center text-[10px] font-bold">4</span>
              <span>Kompiluj EPUB</span>
            </button>
          </div>
        </div>

        <!-- Grupa 2: Narzędzia Eksportu Windows / WSL -->
        <div class="space-y-1.5">
          <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
            Eksport i Eksplorator:
          </span>
          <div class="flex flex-wrap items-center gap-2">
