---
// PDF to EPUB Studio - Astro SSR Page
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="pl" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PDF to EPUB Studio - Panel Inspekcji i Naprawy</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2310b981'><path d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'/></svg>" />
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col selection:bg-emerald-500/30 selection:text-emerald-300">
  <!-- Top Navigation Bar -->
  <header class="border-b border-zinc-800/80 bg-zinc-900/60 backdrop-blur sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <h1 class="font-bold text-lg leading-tight tracking-tight text-white flex items-center gap-2">
            PDF to EPUB Studio
            <span class="text-xs font-mono font-medium px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300 border border-zinc-700">WSL/Windows</span>
          </h1>
          <p class="text-xs text-zinc-400">Książki kucharskie &middot; OCR &middot; Markdown &middot; EPUB 3</p>
        </div>
      </div>

      <!-- Book Selector, WSL Actions & AI Engine Pill -->
      <div class="flex items-center gap-3">
        <!-- Wybór książki -->
        <div class="flex items-center gap-2 bg-zinc-900 border border-zinc-700/80 rounded-lg px-3 py-1.5 text-sm">
          <span class="text-xs text-zinc-400 font-medium">Książka:</span>
          <select id="bookSelector" class="bg-transparent text-emerald-400 font-mono font-medium focus:outline-none cursor-pointer">
            <option value="ksiazka" class="bg-zinc-900 text-zinc-100">ksiazka</option>
          </select>
        </div>

        <div id="ollamaBadge" class="flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs font-mono transition-all cursor-pointer hover:border-zinc-500" title="Kliknij, aby sprawdzić instrukcję połączenia z Ollama na Windows">
          <span class="relative flex h-2 w-2">
            <span id="ollamaPing" class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"></span>
            <span id="ollamaDot" class="relative inline-flex rounded-full h-2 w-2"></span>
          </span>
          <span id="ollamaText">Sprawdzanie Ollama...</span>
        </div>

        <div class="hidden sm:flex items-center gap-1.5 text-xs text-zinc-500 font-mono bg-zinc-900/40 px-2.5 py-1.5 rounded border border-zinc-800">
          <span>PORT:</span>
          <span class="text-zinc-300 font-semibold">4343</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full space-y-6">
    
    <!-- Top Action Banner & Quick Metrics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <!-- Metric 1: Plik Markdown -->
      <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-400 text-xs font-medium uppercase tracking-wider mb-2">
          <span>Źródło Markdown (.md)</span>
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="statMdLines" class="text-2xl font-bold font-mono text-zinc-100">---</span>
          <span class="text-xs text-zinc-400">linii tekstu</span>
        </div>
        <div class="mt-2 text-xs text-zinc-400 flex items-center justify-between">
          <span id="statMdSize">Rozmiar: -- MB</span>
          <span id="statMdStatus" class="text-emerald-400 font-medium">Dostępny</span>
        </div>
      </div>

      <!-- Metric 2: Anomalie OCR -->
      <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-400 text-xs font-medium uppercase tracking-wider mb-2">
          <span>Wykryte Anomalie</span>
          <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="statAnomalyTotal" class="text-2xl font-bold font-mono text-rose-400">---</span>
          <span class="text-xs text-zinc-400">do poprawy</span>
        </div>
        <div class="mt-2 text-xs flex items-center gap-2 font-mono">
          <span class="text-rose-400 font-medium" id="statHighBadge">High: --</span>
          <span class="text-zinc-600">&middot;</span>
          <span class="text-amber-400 font-medium" id="statMedBadge">Med: --</span>
          <span class="text-zinc-600">&middot;</span>
          <span class="text-zinc-400" id="statLowBadge">Low: --</span>
        </div>
      </div>

      <!-- Metric 3: Kompilacja EPUB -->
      <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-400 text-xs font-medium uppercase tracking-wider mb-2">
          <span>Kompilacja EPUB 3 (.epub)</span>
          <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="statEpubSize" class="text-2xl font-bold font-mono text-zinc-100">---</span>
          <span id="statEpubLabel" class="text-xs text-zinc-400">gotowy</span>
        </div>
        <div class="mt-2 text-xs flex items-center justify-between">
          <span id="statEpubTime" class="text-zinc-400">Zaktualizowano: --</span>
          <a id="btnDownloadEpub" href="/api/download" class="text-indigo-400 hover:text-indigo-300 font-medium hover:underline flex items-center gap-1">
            Pobierz &darr;
          </a>
        </div>
      </div>

      <!-- Metric 4: AI & Sprzęt (RTX 4080 Super) -->
      <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-xl p-4 flex flex-col justify-between">
        <div class="flex items-center justify-between text-zinc-400 text-xs font-medium uppercase tracking-wider mb-2">
          <span>Akceleracja AI</span>
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="flex items-baseline gap-2">
          <span id="statGpuLabel" class="text-lg font-bold font-mono text-emerald-400">RTX 4080 S</span>
          <span class="text-xs text-zinc-400 font-mono">16GB VRAM</span>
        </div>
        <div class="mt-2 text-xs text-zinc-400 flex items-center justify-between">
          <span id="statModelName">Model: Qwen 2.5 / VS Code</span>
          <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">0 PLN API</span>
        </div>
      </div>
    </div>

    <!-- PIPELINE ACTION BAR (Z auto-tworzeniem Markdowna) -->
    <div class="bg-zinc-900/90 border border-zinc-800 rounded-xl p-4 flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mr-1">Akcje:</span>
        <button id="btnRunExtract" class="px-3 py-2 bg-zinc-800 hover:bg-zinc-700 text-cyan-300 rounded-lg text-xs font-medium transition flex items-center gap-1.5 border border-zinc-700" title="Wyekstrahuj PDF do czystego Markdowna">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Ekstrahuj z PDF
        </button>
        <button id="btnRunClean" class="px-3 py-2 bg-zinc-800 hover:bg-zinc-700 text-amber-300 rounded-lg text-xs font-medium transition flex items-center gap-1.5 border border-zinc-700" title="Rekonstrukcja polskich znaków, ułamków i de-hyphenation">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
          Wyczyść Tekst
        </button>
        <button id="btnRunAudit" class="px-3 py-2 bg-zinc-800 hover:bg-zinc-700 text-rose-300 rounded-lg text-xs font-medium transition flex items-center gap-1.5 border border-zinc-700" title="Sprawdź tekst pod kątem uszkodzeń OCR">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          Uruchom Audyt
        </button>
        <button id="btnRunBuild" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-medium transition flex items-center gap-1.5 shadow-sm" title="Kompiluj Markdown do EPUB 3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
          Kompiluj EPUB
        </button>
      </div>

      <!-- WSL & Windows Easy Copy & Cleanup Buttons -->
      <div class="flex flex-wrap items-center gap-2 border-t sm:border-t-0 pt-2 sm:pt-0 w-full sm:w-auto justify-end">
        <button id="btnOpenWindowsExplorer" class="px-3 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg text-xs font-medium transition flex items-center gap-1.5 border border-zinc-700" title="Otwórz folder aplikacji/projektu w Eksploratorze Windows (explorer.exe)">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
          Folder Aplikacji
        </button>
        <button id="btnCopyToWindows" class="px-3 py-2 bg-zinc-800 hover:bg-zinc-700 text-indigo-300 rounded-lg text-xs font-medium transition flex items-center gap-1.5 border border-zinc-700" title="Kopiuj gotowy EPUB bezpośrednio do folderu Pobrane w Windows">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"/></svg>
          Pobrane w Windows
        </button>
        <button id="btnPurgeEpub" class="px-3 py-2 bg-zinc-800/80 hover:bg-rose-950/40 text-amber-300 hover:text-amber-200 rounded-lg text-xs font-medium transition flex items-center gap-1.5 border border-zinc-700" title="Usuń wyłącznie gotowy plik .epub dla tej książki">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          Usuń EPUB
        </button>
        <button id="btnPurgeWorkfiles" class="px-3 py-2 bg-zinc-800/80 hover:bg-rose-950/60 text-zinc-400 hover:text-rose-300 rounded-lg text-xs font-medium transition flex items-center gap-1.5 border border-zinc-700" title="Wyczyść pliki robocze lub zresetuj wszystko">
          <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          Wyczyść pliki
        </button>
      </div>
    </div>

    <!-- Status feedback banner -->
    <div id="pipelineStatusBanner" class="hidden rounded-xl p-3 text-xs font-mono border transition-all">
      <span id="pipelineStatusText"></span>
    </div>

    <!-- AUTOPILOT CONTROL CARD (Sequential batch fixing) -->
    <div class="relative overflow-hidden bg-gradient-to-br from-zinc-900 via-zinc-900 to-emerald-950/20 border border-emerald-500/30 rounded-2xl p-5 shadow-xl space-y-4">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <h2 class="text-base font-bold text-white tracking-tight flex items-center gap-2">
              Autopilot Naprawczy AI
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-normal">Koniec z klikaniem</span>
            </h2>
          </div>
          <p class="text-xs text-zinc-400 max-w-2xl leading-relaxed">
            Autopilot przechodzi kolejno przez wszystkie wykryte uszkodzenia OCR i nanosi poprawki bezpośrednio do pliku Markdown, a po ukończeniu automatycznie kompiluje EPUB.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Model Selection Dropdown -->
          <div class="flex items-center gap-1.5 bg-zinc-950/90 border border-zinc-700/80 rounded-xl px-3 py-1.5 shadow-inner">
            <label for="modelSelector" class="text-[11px] font-mono text-zinc-400">Model AI:</label>
            <select id="modelSelector" class="bg-transparent text-emerald-300 text-xs font-mono focus:outline-none cursor-pointer">
              <option value="qwen2.5:14b">qwen2.5:14b (RTX 4080 S)</option>
              <option value="qwen2.5-coder:14b">qwen2.5-coder:14b</option>
              <option value="qwen2.5-coder:7b">qwen2.5-coder:7b</option>
              <option value="qwen2.5-coder:1.5b-base">qwen2.5-coder:1.5b-base</option>
              <option value="heuristic">Silnik Regułowy (Wbudowany)</option>
            </select>
          </div>

          <!-- Ollama Autopilot Button -->
          <button id="btnStartOllamaAutopilot" class="px-4 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 rounded-xl text-xs font-bold transition flex items-center gap-2 shadow-lg shadow-emerald-500/10">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/></svg>
            <span>Uruchom Autopilot</span>
          </button>

          <!-- Heuristic Batch Button -->
          <button id="btnHeuristicBatch" class="px-3.5 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 border border-zinc-700" title="Automatyczna rekonstrukcja polskich znaków, ułamków i szumów OCR">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Szybka Rekonstrukcja
          </button>

          <!-- Quality Explanation Button -->
          <button id="btnShowQualityInfo" class="px-3 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-xl text-xs font-medium transition flex items-center gap-1.5 border border-zinc-700" title="Jak mierzymy jakość i eliminujemy halucynacje?">
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Jak mierzymy jakość?
          </button>

          <!-- Copy Prompt for VS Code Agent -->
          <button id="btnCopyAgentPrompt" class="px-3 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 border border-zinc-700" title="Kopiuj gotowy prompt dla agenta w VS Code">
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
            Prompt VS Code
          </button>
        </div>
      </div>

      <!-- Autopilot Live Progress Container with Real-time Two-Column Before / After Diff -->
      <div id="autopilotProgressBox" class="mt-4 pt-4 border-t border-zinc-800/80 hidden space-y-3">
        <div class="flex items-center justify-between text-xs font-mono">
          <span id="autopilotStepLabel" class="text-emerald-400 font-semibold">Trwa naprawa akapitu...</span>
          <span id="autopilotProgressPercent" class="text-zinc-400 font-bold">0%</span>
        </div>
        <div class="w-full bg-zinc-800 rounded-full h-2 overflow-hidden">
          <div id="autopilotProgressBar" class="bg-emerald-500 h-2 rounded-full transition-all duration-300 w-0"></div>
        </div>
        <div class="flex items-center justify-between text-[11px] text-zinc-400 font-mono">
          <span id="autopilotCurrentDetails">Akapit: #0</span>
          <button id="btnStopAutopilot" class="text-rose-400 hover:text-rose-300 font-semibold hover:underline">Zatrzymaj Autopilot</button>
        </div>

        <!-- Real-time Two-Column Before / After Diff Box -->
        <div class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
          <div class="bg-rose-950/20 border border-rose-900/40 rounded-xl p-3 space-y-1">
            <div class="flex items-center justify-between text-[11px] font-mono text-rose-300 font-bold">
              <span>● PRZED (Oryginał OCR)</span>
              <span id="liveDiffIndex" class="text-zinc-400">#--</span>
            </div>
            <div id="liveDiffBefore" class="text-xs font-mono text-rose-200/90 whitespace-pre-wrap leading-relaxed max-h-24 overflow-y-auto">
              Oczekiwanie na pierwszy akapit...
            </div>
          </div>
          <div class="bg-emerald-950/20 border border-emerald-900/40 rounded-xl p-3 space-y-1">
            <div class="flex items-center justify-between text-[11px] font-mono text-emerald-300 font-bold">
              <span>● PO (Zrekonstruowany tekst)</span>
              <span id="liveDiffQuality" class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">Jakość: --</span>
            </div>
            <div id="liveDiffAfter" class="text-xs font-mono text-emerald-200/90 whitespace-pre-wrap leading-relaxed max-h-24 overflow-y-auto">
              Oczekiwanie na pierwszy akapit...
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ANOMALY EXPLORER & DIFF SECTION -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <h3 class="text-base font-bold text-white tracking-tight">Katalog Wykrytych Wad OCR</h3>
          <span id="anomalyCounterBadge" class="text-xs font-mono px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-300 border border-zinc-700">Ładowanie...</span>
        </div>

        <!-- Filter & Search Controls -->
