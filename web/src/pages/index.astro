    const autopilotProgressBar = document.getElementById('autopilotProgressBar');
    const autopilotStepLabel = document.getElementById('autopilotStepLabel');
    const autopilotProgressPercent = document.getElementById('autopilotProgressPercent');
    const autopilotCurrentDetails = document.getElementById('autopilotCurrentDetails');
    const btnStopAutopilot = document.getElementById('btnStopAutopilot');

    // Pipeline action buttons
    const btnRunExtract = document.getElementById('btnRunExtract');
    const btnRunClean = document.getElementById('btnRunClean');
    const btnRunAudit = document.getElementById('btnRunAudit');
    const btnRunBuild = document.getElementById('btnRunBuild');
    const btnDownloadEpub = document.getElementById('btnDownloadEpub');
    const btnCopyToWindows = document.getElementById('btnCopyToWindows');
    const btnOpenWindowsExplorer = document.getElementById('btnOpenWindowsExplorer');
    const btnPurgeEpub = document.getElementById('btnPurgeEpub');
    const btnPurgeWorkfiles = document.getElementById('btnPurgeWorkfiles');

    // System powiadomień Toast (Zastępuje natywne browser alert)
    function showToast(message, type = 'info', duration = 3500) {
      const container = document.getElementById('toastContainer');
      if (!container) return;

      const toast = document.createElement('div');
      let colorClasses = 'bg-zinc-900/95 border-zinc-700 text-zinc-200';
      if (type === 'success') colorClasses = 'bg-emerald-950/95 border-emerald-500/40 text-emerald-200';
      else if (type === 'error') colorClasses = 'bg-rose-950/95 border-rose-500/40 text-rose-200';
      else if (type === 'warning') colorClasses = 'bg-amber-950/95 border-amber-500/40 text-amber-200';

      toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-xl border shadow-2xl text-xs font-medium transition-all duration-300 transform translate-y-2 opacity-0 backdrop-blur-md ${colorClasses}`;
      toast.innerHTML = `<span>${escapeHtml(message)}</span>`;

      container.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
      });

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, duration);
    }

    // Bezpieczne kopiowanie do schowka z powiadomieniem
    window.copyToClipboard = function(text, successMsg = 'Skopiowano do schowka!') {
      navigator.clipboard.writeText(text).then(() => {
        showToast(successMsg, 'success');
      }).catch(err => {
        showToast('Błąd kopiowania: ' + err.message, 'error');
      });
    };

    // Nowoczesny modal potwierdzenia (Zastępuje natywne browser confirm)
    let pendingConfirmAction = null;
    function showConfirmModal({ title, message, confirmText = 'Potwierdź', danger = false, onConfirm }) {
      const modal = document.getElementById('confirmModal');
      const titleEl = document.getElementById('confirmModalTitle');
      const msgEl = document.getElementById('confirmModalMessage');
      const btnAccept = document.getElementById('btnAcceptConfirm');

      if (!modal || !titleEl || !msgEl || !btnAccept) return;

      titleEl.textContent = title;
      msgEl.textContent = message;
      btnAccept.textContent = confirmText;
      btnAccept.className = danger
        ? 'px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white rounded-xl text-xs font-semibold shadow transition'
        : 'px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-semibold shadow transition';

      pendingConfirmAction = onConfirm;
      modal.classList.remove('hidden');
    }

    function closeConfirmModal() {
      const modal = document.getElementById('confirmModal');
      if (modal) modal.classList.add('hidden');
      pendingConfirmAction = null;
    }

    // Modal konfiguracji Ollama Windows + WSL
    function openOllamaModal() {
      const modal = document.getElementById('ollamaModal');
      const statusBox = document.getElementById('modalOllamaStatusBox');
      if (!modal) return;

      if (globalOllama && globalOllama.available) {
        statusBox.className = 'p-3.5 rounded-xl text-xs font-mono border bg-emerald-500/10 border-emerald-500/30 text-emerald-300 flex items-start gap-2.5';
        statusBox.innerHTML = `
          <svg class="w-4 h-4 mt-0.5 shrink-0 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <div>
            <span class="font-bold">Ollama jest połączona i gotowa do pracy!</span>
            <p class="mt-1 text-zinc-300 font-sans leading-relaxed">
              Wykryte modele na karcie RTX 4080 Super: <strong>${(globalOllama.models || []).join(', ') || 'qwen2.5:14b'}</strong>.
            </p>
          </div>
        `;
      } else {
        statusBox.className = 'p-3.5 rounded-xl text-xs font-mono border bg-amber-500/10 border-amber-500/30 text-amber-300 flex items-start gap-2.5';
        statusBox.innerHTML = `
          <svg class="w-4 h-4 mt-0.5 shrink-0 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <div>
            <span class="font-bold">Ollama działa w systemie Windows, a pipeline w WSL.</span>
            <p class="mt-1 text-zinc-300 font-sans leading-relaxed">
              Domyślnie Windows blokuje dostęp do portu 11434 spoza localhost. Aby Ollama przyjmowała połączenia z WSL, wystarczy jednorazowo wykonać poniższe polecenie w PowerShell.
            </p>
          </div>
        `;
      }

      modal.classList.remove('hidden');
    }

    function closeOllamaModal() {
      const modal = document.getElementById('ollamaModal');
      if (modal) modal.classList.add('hidden');
    }

    // Modal wyjaśniający metodologię pomiaru jakości
    function openQualityModal() {
      const modal = document.getElementById('qualityModal');
      if (modal) modal.classList.remove('hidden');
    }

    function closeQualityModal() {
      const modal = document.getElementById('qualityModal');
      if (modal) modal.classList.add('hidden');
    }

    // Inicjalizacja: pobranie listy książek i statusu
    async function init() {
      await loadBooks();
      await fetchStatus();
      setupEventListeners();
    }

    async function loadBooks() {
      try {
        const res = await fetch('/api/files');
        const data = await res.json();
        if (data.books && data.books.length > 0) {
          bookSelector.innerHTML = data.books.map(b => {
            const badge = b.hasEpub ? '✓ EPUB gotowy' : b.hasMd ? 'MD gotowy' : 'Tylko PDF';
            return `<option value="${b.stem}">${b.stem} (${badge})</option>`;
          }).join('');
        }
      } catch (e) {
        console.error('Błąd pobierania listy książek:', e);
      }
    }

    async function fetchStatus() {
      const currentBook = bookSelector.value || 'ksiazka';
      try {
        const res = await fetch(`/api/status?book=${encodeURIComponent(currentBook)}`);
        const data = await res.json();

        // 1. Wskaźnik Ollama i selektor modeli
        globalOllama = data.ollama || { available: false, models: [] };
        const modelSelector = document.getElementById('modelSelector');
        if (globalOllama.available) {
          ollamaBadge.className = 'flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs font-mono bg-emerald-500/10 border-emerald-500/30 text-emerald-300 cursor-pointer hover:border-emerald-400';
          ollamaPing.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75';
          ollamaDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-emerald-500';
          const defaultModel = globalOllama.models[0] || 'qwen2.5:14b';
          ollamaText.textContent = `Ollama Online (${defaultModel})`;
          document.getElementById('statModelName').textContent = `Ollama: ${defaultModel}`;

          if (modelSelector && globalOllama.models && globalOllama.models.length > 0) {
            const currentVal = modelSelector.value;
            const llmModels = globalOllama.models.filter(m => !m.includes('embed'));
            const embedModels = globalOllama.models.filter(m => m.includes('embed'));
            const allOptions = [...llmModels, ...embedModels];

            modelSelector.innerHTML = allOptions.map(m => {
              const isEmbed = m.includes('embed');
              const suffix = isEmbed ? ' (Embedding — nie służy do napraw)' : '';
              return `<option value="${escapeHtml(m)}" ${isEmbed ? 'disabled' : ''}>${escapeHtml(m)}${suffix}</option>`;
            }).join('') + '<option value="heuristic">Silnik Regułowy (Wbudowany)</option>';

            const saved = localStorage.getItem('selectedOllamaModel');
            if (saved && allOptions.includes(saved)) {
              modelSelector.value = saved;
            } else if (currentVal && allOptions.includes(currentVal)) {
              modelSelector.value = currentVal;
            } else if (llmModels.length > 0) {
              modelSelector.value = llmModels[0];
            }
          }
        } else {
          ollamaBadge.className = 'flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs font-mono bg-zinc-800 border-zinc-700 text-zinc-400 cursor-pointer hover:border-zinc-500';
          ollamaPing.className = 'hidden';
          ollamaDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-zinc-500';
          ollamaText.textContent = 'Ollama Offline (Kliknij po instrukcję Windows)';
          document.getElementById('statModelName').textContent = 'Autopilot Wbudowany / VS Code';
        }

        // 2. Metryki Markdown (auto-tworzenie info)
        if (data.mdInfo && data.mdInfo.exists) {
          document.getElementById('statMdLines').textContent = data.mdInfo.lines.toLocaleString();
          document.getElementById('statMdSize').textContent = `Rozmiar: ${data.mdInfo.size}`;
          document.getElementById('statMdStatus').textContent = 'Zsynchronizowany';
          document.getElementById('statMdStatus').className = 'text-emerald-400 font-medium';
        } else {
          document.getElementById('statMdLines').textContent = 'Brak';
          document.getElementById('statMdSize').textContent = 'Rozmiar: 0 MB';
          document.getElementById('statMdStatus').textContent = 'Utworzy się automatycznie';
          document.getElementById('statMdStatus').className = 'text-amber-400 font-medium';
        }

        // 3. Metryki EPUB
        if (data.epubInfo && data.epubInfo.exists) {
          document.getElementById('statEpubSize').textContent = data.epubInfo.size;
          document.getElementById('statEpubTime').textContent = `Kompilacja: ${data.epubInfo.mtime}`;
          document.getElementById('statEpubLabel').textContent = `${data.epubInfo.filename}`;
          btnDownloadEpub.href = `/api/download?file=${encodeURIComponent(data.epubInfo.filename)}`;
          btnDownloadEpub.classList.remove('pointer-events-none', 'opacity-50');
        } else {
          document.getElementById('statEpubSize').textContent = 'Brak';
          document.getElementById('statEpubTime').textContent = 'Wymaga kompilacji';
          document.getElementById('statEpubLabel').textContent = `${currentBook}.epub`;
          btnDownloadEpub.classList.add('pointer-events-none', 'opacity-50');
        }

        // 4. Anomalie i raport
        globalReport = data.report;
        if (globalReport && globalReport.anomalies) {
          const total = globalReport.total_anomalies || globalReport.anomalies.length;
          const high = globalReport.by_severity?.HIGH || globalReport.high_severity_count || 0;
          const med = globalReport.by_severity?.MEDIUM || globalReport.medium_severity_count || 0;
          const low = globalReport.by_severity?.LOW || globalReport.low_severity_count || 0;

          document.getElementById('statAnomalyTotal').textContent = total;
          document.getElementById('statHighBadge').textContent = `High: ${high}`;
          document.getElementById('statMedBadge').textContent = `Med: ${med}`;
          document.getElementById('statLowBadge').textContent = `Low: ${low}`;
          anomalyCounterBadge.textContent = `${total} usterek`;

          renderAnomalies();
        } else {
          anomaliesList.innerHTML = `
            <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-8 text-center text-zinc-400">
              <p class="font-medium">Brak wygenerowanego raportu audytu dla ${currentBook}.</p>
              <p class="text-xs text-zinc-500 mt-1">Kliknij "Uruchom Audyt" lub "Wyczyść Tekst" — plik Markdown utworzy się automatycznie!</p>
            </div>
          `;
        }
      } catch (e) {
        console.error('Błąd odświeżania statusu:', e);
      }
    }

    function renderAnomalies() {
      if (!globalReport || !globalReport.anomalies) return;

      let list = globalReport.anomalies;

      if (activeFilter !== 'ALL') {
        list = list.filter(a => a.severity.toUpperCase() === activeFilter);
      }

      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase();
        list = list.filter(a => 
          (a.paragraph_index !== undefined && a.paragraph_index.toString().includes(q)) ||
          (a.raw_paragraph && a.raw_paragraph.toLowerCase().includes(q)) ||
          (a.snippet && a.snippet.toLowerCase().includes(q)) ||
          (a.reason && a.reason.toLowerCase().includes(q))
        );
      }

      for (const item of globalReport.anomalies) {
        if (repairStates.get(`${bookSelector.value}:${item.paragraph_index}`)?.working && !list.includes(item)) list = [...list, item];
      }
      if (list.length === 0) {
        anomaliesList.innerHTML = `
          <div class="bg-zinc-900/30 border border-zinc-800/80 rounded-xl p-8 text-center text-zinc-400">
            <svg class="w-8 h-8 mx-auto text-emerald-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <p class="font-semibold text-white">Brak anomalii w tej kategorii!</p>
            <p class="text-xs text-zinc-500 mt-1">Wszystkie akapity są czyste lub zostały zrekonstruowane.</p>
          </div>
        `;
        return;
      }

      anomaliesList.innerHTML = list.map(item => {
        const pIdx = item.paragraph_index;
        const sev = (item.severity || 'low').toUpperCase();
        const severityClass = sev === 'HIGH' 
          ? 'bg-rose-500/10 border-rose-500/30 text-rose-400' 
          : sev === 'MEDIUM' 
            ? 'bg-amber-500/10 border-amber-500/30 text-amber-400' 
            : 'bg-zinc-800 border-zinc-700 text-zinc-300';

        const displaySnippet = item.raw_paragraph || item.snippet || '';

        return `
          <div class="bg-zinc-900/80 border border-zinc-800 hover:border-zinc-700/80 rounded-2xl p-4 transition space-y-3 shadow-lg" id="card-${pIdx}">
            <!-- Header bar -->
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-zinc-800/80 pb-2.5">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-zinc-800 text-zinc-200 border border-zinc-700">#${pIdx}</span>
                <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded border ${severityClass}">${sev}</span>
                <span class="text-xs font-medium text-zinc-300">${escapeHtml(item.reason || item.categories?.join(', ') || 'Anomalia OCR')}</span>
              </div>
              <div class="flex items-center gap-2">
                <button onclick="requestOllamaRepair(${pIdx})" class="px-2.5 py-1 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 rounded-lg text-xs font-medium border border-emerald-500/30 transition flex items-center gap-1 shadow-sm active:scale-95" title="Napraw z użyciem wybranego modelu LLM">
                  <span>⚡ AI Fix</span>
                </button>
                <button onclick="applyHeuristicToCard(${pIdx})" class="px-2.5 py-1 bg-amber-600/20 hover:bg-amber-600/30 text-amber-300 rounded-lg text-xs font-medium border border-amber-500/30 transition flex items-center gap-1 active:scale-95" title="Szybka naprawa znaków i ułamków">
                  <span>Rekonstrukcja</span>
                </button>
                <button onclick="toggleEdit(${pIdx})" class="px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg text-xs font-medium border border-zinc-700 transition">
                  Edytuj
                </button>
              </div>
            </div>

            <!-- TWO-COLUMN BEFORE / AFTER VIEW -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="diff-grid-${pIdx}">
              <!-- Column 1: PRZED (Oryginał OCR) -->
              <div class="bg-rose-950/20 border border-rose-900/40 rounded-xl p-3 flex flex-col justify-between space-y-2">
                <div class="flex items-center justify-between text-[11px] font-mono text-rose-300 font-bold border-b border-rose-900/40 pb-1">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                    PRZED (Oryginał OCR)
                  </span>
                  <span class="text-[10px] text-rose-400/80 font-normal">Szum i usterki</span>
                </div>
                <div class="text-xs font-mono text-rose-200/90 whitespace-pre-wrap leading-relaxed py-1">
                  ${highlightIssues(displaySnippet)}
                </div>
                <div class="text-[10px] font-mono text-rose-400/70 border-t border-rose-900/30 pt-1 flex items-center justify-between">
                  <span>Wykryte błędy: ${escapeHtml(item.categories?.join(', ') || 'szum OCR')}</span>
                </div>
              </div>

              <!-- Column 2: PO (Zrekonstruowany tekst) -->
              <div class="bg-emerald-950/20 border border-emerald-900/40 rounded-xl p-3 flex flex-col justify-between space-y-2" id="after-col-${pIdx}">
                <div class="flex items-center justify-between text-[11px] font-mono text-emerald-300 font-bold border-b border-emerald-900/40 pb-1">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    PO (Zrekonstruowany)
                  </span>
                  <span id="quality-badge-${pIdx}" class="text-[10px] px-1.5 py-0.5 rounded font-bold bg-zinc-800 text-zinc-400">Podgląd</span>
                </div>
                <div id="repaired-preview-${pIdx}" class="text-xs font-mono text-emerald-200/90 whitespace-pre-wrap leading-relaxed py-1">
                  ${escapeHtml(reconstructParagraphHeuristic(displaySnippet))}
                </div>
                <div id="metrics-footer-${pIdx}" class="text-[10px] font-mono text-emerald-400/80 border-t border-emerald-900/30 pt-1 flex items-center justify-between">
                  <span>Propozycja algorytmiczna</span>
                  <button onclick="applyHeuristicToCard(${pIdx})" class="text-emerald-300 hover:text-white underline text-[10px]">Zatwierdź wersję</button>
                </div>
              </div>
            </div>

            <!-- Edit / Patch Panel -->
            <div id="edit-box-${pIdx}" class="space-y-2 pt-2 border-t border-zinc-800/60 hidden">
              <label class="text-[11px] font-semibold text-zinc-400">Ręczna korekta tekstu akapitu:</label>
              <textarea id="input-${pIdx}" class="w-full h-24 bg-zinc-950 border border-zinc-700 rounded-lg p-2.5 text-xs font-mono text-zinc-100 focus:outline-none focus:border-emerald-500">${escapeHtml(reconstructParagraphHeuristic(displaySnippet))}</textarea>
              <div class="flex justify-end gap-2">
                <button onclick="toggleEdit(${pIdx})" class="px-3 py-1.5 text-xs text-zinc-400 hover:text-zinc-200">Anuluj</button>
                <button onclick="applyPatch(${pIdx})" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold shadow transition">
                  Zapisz do Markdown
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
      for (const [key, state] of repairStates) {
        if (key.startsWith(`${bookSelector.value}:`)) displayRepairState(Number(key.split(':').pop()), state);
      }
    }

    function displayRepairState(pIdx, state) {
      const card = document.getElementById(`card-${pIdx}`);
      card?.setAttribute('aria-busy', state.working ? 'true' : 'false');
      if (state.working) card?.classList.add('ring-2', 'ring-cyan-400', 'animate-pulse');
      else card?.classList.remove('ring-2', 'ring-cyan-400', 'animate-pulse');
      const badge = document.getElementById(`quality-badge-${pIdx}`);
      const preview = document.getElementById(`repaired-preview-${pIdx}`);
      const footer = document.getElementById(`metrics-footer-${pIdx}`);
      const input = document.getElementById(`input-${pIdx}`);
      if (badge) {
        badge.classList.remove('animate-pulse');
        badge.textContent = state.label;
      }
      if (preview) preview.textContent = state.text;
      if (footer) footer.textContent = state.details;
      if (input && state.text && !state.working) input.value = state.text;
    }

    function rememberRepair(pIdx, data) {
      const sourcePages = [...new Set((data.sources || []).flatMap(s => s.pages))];
      const state = {
        label: data.success && data.applied ? (data.method === 'source-ocr' ? 'Zapisano — ponowny OCR źródła' : data.method === 'heuristic' ? 'Zapisano reguły — sprawdź audyt' : 'Zapisano — korekta tekstowa') : 'Do kontroli — nie zapisano',
        text: data.repaired || 'Brak wyniku rekonstrukcji.',
        details: data.success && data.applied
          ? `Zapisano do Markdown. ${sourcePages.length ? `Źródło: strony PDF ${sourcePages.join(', ')}. ` : ''}Podobieństwo do starego OCR: ${data.metrics?.similarity ?? '—'}% (ocena heurystyczna).`
          : `${data.error || 'Nie zapisano zmian.'} ${sourcePages.length ? `Sprawdzono strony PDF: ${sourcePages.join(', ')}.` : ''} Propozycja wymaga kontroli.`,
      };
      repairStates.set(`${bookSelector.value}:${pIdx}`, state);
      displayRepairState(pIdx, state);
      return state;
    }

    function highlightIssues(text) {
      if (!text) return '';
      let safe = escapeHtml(text);
      safe = safe.replace(/(\^|°|£|¥|«|»)/g, '<mark class="bg-rose-500/40 text-rose-200 px-0.5 rounded font-bold">$1</mark>');
      return safe;
    }

    function escapeHtml(str) {
      return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    window.toggleEdit = function(pIdx) {
      const box = document.getElementById(`edit-box-${pIdx}`);
      if (box) box.classList.toggle('hidden');
    };

    window.applyPatch = async function(pIdx) {
      const textarea = document.getElementById(`input-${pIdx}`);
      if (!textarea) return;
      if (isAutopilotRunning || activeRepairController) return;
      const text = textarea.value;
      const anomaly = globalReport.anomalies.find(a => a.paragraph_index === pIdx);
      const currentBook = bookSelector.value || 'ksiazka';

      try {
        const res = await fetch('/api/patch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ index: pIdx, text, original: anomaly?.raw_paragraph, file: `${currentBook}.md` })
        });
        const result = await res.json();
        if (result.success) {
          const qualityBadge = document.getElementById(`quality-badge-${pIdx}`);
          const metricsFooter = document.getElementById(`metrics-footer-${pIdx}`);
          const previewEl = document.getElementById(`repaired-preview-${pIdx}`);
          const editBox = document.getElementById(`edit-box-${pIdx}`);

          if (previewEl) previewEl.textContent = text;
          if (qualityBadge) {
            qualityBadge.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300';
            qualityBadge.textContent = 'Zapisano ręczną korektę';
          }
          if (metricsFooter) {
            metricsFooter.innerHTML = `
              <span class="text-zinc-400">Ręczna edycja zatwierdzona</span>
              <span class="text-emerald-400 font-bold">✓ Zapisano do MD (.bak)</span>
            `;
          }
          if (anomaly) anomaly.raw_paragraph = text;
          repairStates.set(`${currentBook}:${pIdx}`, { text, label: 'Zapisano ręczną korektę', details: 'Ręczna korekta zapisana do Markdown.' });
          if (editBox) editBox.classList.add('hidden');
          showToast(`✓ Zapisano poprawkę dla akapitu #${pIdx}`, 'success');
        } else {
          showToast('Błąd zapisu poprawki: ' + result.error, 'error');
        }
      } catch (err) {
        showToast('Błąd sieciowy: ' + err.message, 'error');
      }
    };

    window.applyHeuristicToCard = async function(pIdx) {
      if (isAutopilotRunning || activeRepairController) return;
      const currentBook = bookSelector.value || 'ksiazka';
      const anomaly = globalReport.anomalies.find(a => a.paragraph_index === pIdx);
      if (!anomaly) return;

      const raw = anomaly.raw_paragraph || anomaly.snippet;
      const repaired = reconstructParagraphHeuristic(raw);

      try {
        const res = await fetch('/api/patch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ index: pIdx, text: repaired, original: raw, file: `${currentBook}.md` })
        });
        const result = await res.json();
        if (result.success) {
          const qualityBadge = document.getElementById(`quality-badge-${pIdx}`);
          const metricsFooter = document.getElementById(`metrics-footer-${pIdx}`);
          const previewEl = document.getElementById(`repaired-preview-${pIdx}`);
          const textarea = document.getElementById(`input-${pIdx}`);

          if (textarea) textarea.value = repaired;
          if (previewEl) previewEl.textContent = repaired;
          if (qualityBadge) {
            qualityBadge.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300';
            qualityBadge.textContent = 'Zapisano reguły — sprawdź audyt';
          }
          if (metricsFooter) {
            metricsFooter.innerHTML = `
              <span class="text-zinc-400">Znormalizowano ułamki i szum OCR</span>
              <span class="text-emerald-400 font-bold">✓ Zapisano do MD (.bak)</span>
            `;
          }
          anomaly.raw_paragraph = repaired;
          repairStates.set(`${currentBook}:${pIdx}`, { text: repaired, label: result.changed ? 'Zapisano reguły — sprawdź audyt' : 'Bez zmian', details: 'Reguły nie gwarantują pełnej rekonstrukcji.' });
          displayRepairState(pIdx, repairStates.get(`${currentBook}:${pIdx}`));
          showToast(result.changed ? `Zapisano reguły dla #${pIdx}` : 'Brak zmian', result.changed ? 'success' : 'info');
        } else {
          showToast(result.error || 'Nie zapisano poprawki', 'error');
        }
      } catch (e) {
        showToast('Błąd zapisu: ' + e.message, 'error');
      }
    };

    window.requestOllamaRepair = async function(pIdx) {
      if (isAutopilotRunning || activeRepairController) return;
      const currentBook = bookSelector.value || 'ksiazka';
      const anomaly = globalReport.anomalies.find(a => a.paragraph_index === pIdx);
      if (!anomaly) return;
      const card = document.getElementById(`card-${pIdx}`);
      if (card?.getAttribute('aria-busy') === 'true') return;
      card?.setAttribute('aria-busy', 'true');
      card?.classList.add('ring-2', 'ring-cyan-400');
      activeRepairController = new AbortController();
      bookSelector.disabled = true;
      repairStates.set(`${currentBook}:${pIdx}`, { working: true, label: 'Trwa naprawa', text: 'Naprawa tekstu i w razie potrzeby odczyt PDF…', details: 'Oczekiwanie na wynik; plik nie został jeszcze zmieniony.' });
      let elapsed = 0;
      const timer = setInterval(() => {
        const badge = document.getElementById(`quality-badge-${pIdx}`);
        const pending = repairStates.get(`${currentBook}:${pIdx}`);
        if (pending?.working) {
          pending.label = `Naprawa / odczyt PDF: ${++elapsed} s`;
          displayRepairState(pIdx, pending);
        }
      }, 1000);

      const modelSelect = document.getElementById('modelSelector');
      const selectedModel = modelSelect ? modelSelect.value : 'qwen2.5:14b';

      const qualityBadge = document.getElementById(`quality-badge-${pIdx}`);
      const metricsFooter = document.getElementById(`metrics-footer-${pIdx}`);
      const previewEl = document.getElementById(`repaired-preview-${pIdx}`);
      const textarea = document.getElementById(`input-${pIdx}`);

      if (qualityBadge) {
        qualityBadge.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-cyan-500/20 text-cyan-300 animate-pulse';
        qualityBadge.textContent = `Generowanie (${selectedModel})...`;
      }
      if (previewEl) {
        previewEl.innerHTML = `<span class="text-zinc-400 italic">Trwa zapytanie do modelu ${escapeHtml(selectedModel)}...</span>`;
      }

      try {
        const res = await fetch('/api/ollama-repair', {
          signal: activeRepairController.signal,
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            index: pIdx,
            paragraph: anomaly.raw_paragraph || anomaly.snippet,
            reason: anomaly.reason || anomaly.categories?.join(', '),
            file: `${currentBook}.md`,
            model: selectedModel,
            apply: true
          })
        });
        const data = await res.json();
        if (data.success && data.applied && data.repaired) {
          if (textarea) textarea.value = data.repaired;
          if (previewEl) previewEl.textContent = data.repaired;
          anomaly.raw_paragraph = data.repaired;
          rememberRepair(pIdx, data);
          showToast(`✓ Akapit #${pIdx} zrekonstruowany i zapisany (${selectedModel})!`, 'success');
        } else {
          showToast('Ollama: ' + (data.error || 'Błąd odpowiedzi'), 'warning');
          rememberRepair(pIdx, data);

        }
      } catch (err) {
        rememberRepair(pIdx, { error: err.message });
        showToast('Błąd komunikacji z modelem: ' + err.message, 'error');
        if (qualityBadge) qualityBadge.textContent = 'Błąd połączenia — nie zapisano';
        if (previewEl) previewEl.textContent = 'Brak wyniku rekonstrukcji.';
        if (metricsFooter) metricsFooter.textContent = err.message;
      } finally {
        clearInterval(timer);
        activeRepairController = null;
        bookSelector.disabled = false;
        card?.classList.remove('ring-2', 'ring-cyan-400');
        qualityBadge?.classList.remove('animate-pulse');
        card?.setAttribute('aria-busy', 'false');
      }
    };

    // Wbudowany algorytmiczny silnik rekonstrukcji tekstu (polskie znaki, ułamki, szumy OCR)
    function reconstructParagraphHeuristic(text) {
      if (!text) return '';
      let t = text;
      // Scalanie rozbitych słów (de-hyphenation)
      t = t.replace(/(\b[a-zA-ZąćęłńóśźżĄĆĘŁŃÓŚŹŻ]+)-\s+([a-zA-ZąćęłńóśźżĄĆĘŁŃÓŚŹŻ]+\b)/g, '$1$2');
      // Ułamki
      t = t.replace(/\bVz\b/g, '1/2');
      t = t.replace(/\b¥2\b/g, '1/2');
      t = t.replace(/3\/«/g, '3/4');
      t = t.replace(/½/g, '1/2');
      t = t.replace(/¼/g, '1/4');
      t = t.replace(/¾/g, '3/4');
      t = t.replace(/\b1\s+2\s+(tsp|tbsp|cup|cups|teaspoon|tablespoon|lb|lbs|oz|clove|pinch|stick)\b/gi, '1/2 $1');
      t = t.replace(/\b1\s+4\s+(tsp|tbsp|cup|cups|teaspoon|tablespoon|lb|lbs|oz|clove|pinch|stick)\b/gi, '1/4 $1');
      t = t.replace(/\b3\s+4\s+(tsp|tbsp|cup|cups|teaspoon|tablespoon|lb|lbs|oz|clove|pinch|stick)\b/gi, '3/4 $1');
      // Zbitki OCR (ha^been -> has been itp.)
      t = t.replace(/\bha\^been\b/g, 'has been');
      t = t.replace(/\bin\s+die\s+oven\b/gi, 'in the oven');
      t = t.replace(/\bin\s+die\s+/gi, 'in the ');
      t = t.replace(/\bdie\s+oven\b/gi, 'the oven');
      t = t.replace(/\bdie\s+sauce\b/gi, 'the sauce');
      t = t.replace(/\bdie\s+pan\b/gi, 'the pan');
      t = t.replace(/\bdie\s+meat\b/gi, 'the meat');
      // Polskie diakrytyki i usterki OCR
      t = t.replace(/\bgol\^bki\b/gi, 'gołąbki');
      t = t.replace(/\bgolgbki\b/gi, 'gołąbki');
      t = t.replace(/\bkapust\^/gi, 'kapustą');
      t = t.replace(/\bw\^trob/gi, 'wątrób');
      t = t.replace(/\bpstr\^g/gi, 'pstrąg');
      t = t.replace(/\bmies\^/gi, 'mięsa');
      t = t.replace(/saut£/g, 'sauté');
      t = t.replace(/pur£e/g, 'purée');
      t = t.replace(/canap£/g, 'canapé');
      t = t.replace(/£wiez/gi, 'śwież');
      t = t.replace(/£mietan/gi, 'śmietan');
      t = t.replace(/£liw/gi, 'śliw');
      t = t.replace(/kurcz£/gi, 'kurczę');
      // Szumy skanera
      t = t.replace(/■\s*\^p-/g, '');
      t = t.replace(/FlraS\s*-\*/g, '');
      return t;
    }

    // AUTOPILOT AI (Z dynamicznym wyborem modelu z Ollama lub silnika regułowego)
    async function startOllamaAutopilot() {
      if (!globalReport || !globalReport.anomalies || globalReport.anomalies.length === 0) {
        showStatus('Brak wykrytych anomalii do naprawy. Plik jest czysty!', 'info');
        return;
      }

      if (isAutopilotRunning || activeRepairController) return;
      const currentBook = bookSelector.value || 'ksiazka';
      const anomalies = [...globalReport.anomalies];
      const total = anomalies.length;

      const modelSelect = document.getElementById('modelSelector');
      const selectedModel = modelSelect ? modelSelect.value : 'qwen2.5:14b';
      const isHeuristicOnly = selectedModel === 'heuristic';
      const isAiOnline = !isHeuristicOnly && globalOllama && globalOllama.available;
      if (!isHeuristicOnly && !isAiOnline) {
        showStatus('Ollama jest niedostępna. Uruchom model lub wybierz jawnie silnik regułowy.', 'error');
        return;
      }
      const engineName = isAiOnline ? `Ollama (${selectedModel})` : 'Silnik Regułowy';

      isAutopilotRunning = true;
      stopRequested = false;

      autopilotProgressBox.classList.remove('hidden');
      btnStartOllamaAutopilot.classList.add('opacity-50', 'pointer-events-none');
      
      showStatus(`Uruchamianie Autopilota: ${engineName}...`, 'info');

      let repairedCount = 0;
      let failedCount = 0;
      bookSelector.disabled = true;

      for (let i = 0; i < total; i++) {
        if (stopRequested) break;

        const anomaly = anomalies[i];
        const pIdx = anomaly.paragraph_index;
        const percent = Math.round((i / total) * 100);
        const rawSnippet = anomaly.raw_paragraph || anomaly.snippet || '';

        autopilotStepLabel.textContent = `Autopilot [${engineName}]: Akapit #${pIdx} (${i + 1} z ${total})...`;
        autopilotProgressPercent.textContent = `${percent}%`;
        autopilotProgressBar.style.width = `${percent}%`;
        autopilotCurrentDetails.textContent = `Wada: ${anomaly.reason || anomaly.categories?.join(', ') || 'OCR'}`;

        // Live Diff Panel: Aktualizacja akapitu "PRZED"
        const liveDiffIndex = document.getElementById('liveDiffIndex');
        const liveDiffBefore = document.getElementById('liveDiffBefore');
        const liveDiffAfter = document.getElementById('liveDiffAfter');
        const liveDiffQuality = document.getElementById('liveDiffQuality');

        if (liveDiffIndex) liveDiffIndex.textContent = `#${pIdx}`;
        if (liveDiffBefore) liveDiffBefore.textContent = rawSnippet;
        if (liveDiffAfter) liveDiffAfter.innerHTML = `<span class="italic text-zinc-400">Rekonstrukcja w toku (${engineName})...</span>`;
        if (liveDiffQuality) liveDiffQuality.textContent = 'Analiza...';

        repairStates.set(`${currentBook}:${pIdx}`, { working: true, label: '● Teraz naprawiany', text: 'Naprawa tekstu i w razie potrzeby odczyt PDF…', details: 'Oczekiwanie na wynik.' });
        let repairedText = null;
        let metricData = null;
        const card = document.getElementById(`card-${pIdx}`);
        card?.classList.add('ring-2', 'ring-cyan-400', 'animate-pulse');
        card?.setAttribute('aria-busy', 'true');
        card?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const pendingBadge = document.getElementById(`quality-badge-${pIdx}`);
        if (pendingBadge) pendingBadge.textContent = '● Teraz naprawiany';
        let elapsed = 0;
        const ticker = setInterval(() => {
          elapsed++;
          if (liveDiffQuality) liveDiffQuality.textContent = `Praca: ${elapsed} s`;
          const pending = repairStates.get(`${currentBook}:${pIdx}`);
          if (pending?.working) {
            pending.label = `● Teraz naprawiany (${elapsed} s)`;
            displayRepairState(pIdx, pending);
          }
        }, 1000);
        let repairError = '';


        if (isAiOnline) {
          try {
            activeRepairController = new AbortController();
            const res = await fetch('/api/ollama-repair', {
              signal: activeRepairController.signal,
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                index: pIdx,
                paragraph: rawSnippet,
                reason: anomaly.reason || anomaly.categories?.join(', '),
                file: `${currentBook}.md`,
                model: selectedModel,
                apply: true
              })
            });
            const data = await res.json();
            rememberRepair(pIdx, data);
            if (liveDiffAfter) liveDiffAfter.textContent = data.repaired || data.error;
            if (data.success && data.applied && data.repaired) {
              repairedText = data.repaired;
              anomaly.raw_paragraph = data.repaired;
              if (data.metrics) metricData = data.metrics;
            } else {
              repairError = data.error || 'Nie zapisano poprawki';
            }
          } catch (e) {
            repairError = e.message;
            rememberRepair(pIdx, { error: e.message });
          } finally {
            activeRepairController = null;
          }
        }

        // Fallback do silnika regułowego, jeśli Ollama offline lub zawiodła
        if (!isAiOnline) {
          repairedText = reconstructParagraphHeuristic(rawSnippet);
          try {
            const patchResponse = await fetch('/api/patch', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                index: pIdx,
                text: repairedText,
                original: rawSnippet,
                file: `${currentBook}.md`
              })
            });
            const patchResult = await patchResponse.json();
            if (!patchResponse.ok || !patchResult.success) throw new Error(patchResult.error || 'Błąd zapisu');
            rememberRepair(pIdx, { success: true, applied: patchResult.changed, repaired: repairedText, method: 'heuristic' });
          } catch (err) {
            repairedText = null;
            repairError = err.message;
            rememberRepair(pIdx, { error: err.message });
          }
        }

        clearInterval(ticker);
        const completedPercent = Math.round(((i + 1) / total) * 100);
        autopilotProgressPercent.textContent = `${completedPercent}%`;
        autopilotProgressBar.style.width = `${completedPercent}%`;
        card?.classList.remove('ring-2', 'ring-cyan-400', 'animate-pulse');
        card?.setAttribute('aria-busy', 'false');
        if (!repairedText) {
          failedCount++;
          if (liveDiffAfter && !repairStates.has(`${currentBook}:${pIdx}`)) liveDiffAfter.textContent = repairError || 'Brak wyniku naprawy';
          if (liveDiffQuality) liveDiffQuality.textContent = 'Nie zapisano';
          if (pendingBadge) pendingBadge.textContent = 'Do kontroli — nie zapisano';
          continue;
        }
        if (repairedText) {
          const changed = repairedText.trim() !== rawSnippet.trim();
          if (changed) repairedCount++;
          const resultLabel = !changed ? 'Bez zmian — wymaga kontroli' : metricData ? `Jakość: ${metricData.qualityScore}%` : 'Zapisano reguły — sprawdź audyt';


          // 1. Aktualizacja Live Diff Panel
          if (liveDiffAfter) liveDiffAfter.textContent = repairedText;
          if (liveDiffQuality) {
            liveDiffQuality.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300';
            liveDiffQuality.textContent = resultLabel;
          }

          // 2. Aktualizacja karty w katalogu z zachowaniem obu kolumn PRZED i PO
          const qualityBadge = document.getElementById(`quality-badge-${pIdx}`);
          const previewEl = document.getElementById(`repaired-preview-${pIdx}`);
          const metricsFooter = document.getElementById(`metrics-footer-${pIdx}`);
          const textarea = document.getElementById(`input-${pIdx}`);

          if (textarea) textarea.value = repairedText;
          if (previewEl) previewEl.textContent = repairedText;
          if (qualityBadge) {
            qualityBadge.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300';
            qualityBadge.textContent = resultLabel;
          }
          if (metricsFooter) {
            metricsFooter.innerHTML = `
              <span>Podobieństwo: ${metricData?.similarity ?? '—'}% &middot; Szum: ${metricData?.noiseRemoved ?? '—'} &middot; Liczby: ${metricData ? (metricData.invariantsPreserved ? '✓ Zachowane' : '⚠ Zmienione') : 'Nie oceniono'}</span>
              <span class="text-emerald-400 font-bold">✓ Zapisano do MD (.bak)</span>
            `;
          }
          const savedState = repairStates.get(`${currentBook}:${pIdx}`);
          if (savedState) {
            displayRepairState(pIdx, savedState);
            if (liveDiffQuality) liveDiffQuality.textContent = savedState.label;
          }
        }
      }

      autopilotStepLabel.textContent = stopRequested 
        ? `Autopilot zatrzymany. Zaktualizowano ${repairedCount} akapitów.` 
        : `✓ Zakończono! Zaktualizowano ${repairedCount} z ${total} akapitów. Kompilacja EPUB...`;
      
      btnStartOllamaAutopilot.classList.remove('opacity-50', 'pointer-events-none');
      isAutopilotRunning = false;
      bookSelector.disabled = false;
      if (stopRequested) return;

      // Do not build a new EPUB when the run changed no paragraphs.
      if (!repairedCount) {
        showStatus(`Nie zmieniono akapitów. Do kontroli: ${failedCount} z ${total}.`, 'info');
        return;
      }
      // Automatyczna rekompilacja EPUB i ponowny audyt
      showStatus('Kompilacja EPUB z zapisanych poprawek...', 'info');
      if (!await triggerAction('build')) return;
      showStatus('Odświeżanie raportu jakościowego po naprawie...', 'info');
      if (!await triggerAction('audit')) return;
      showStatus(`Zmieniono ${repairedCount} z ${total} akapitów. Błędy: ${failedCount}. Pozostało anomalii: ${globalReport?.anomalies?.length ?? 'brak raportu'}. EPUB przebudowany.`, failedCount ? 'warning' : 'info');
    }

    // Szybka Rekonstrukcja (Polskie znaki, ułamki i auto-rekompilacja EPUB)
    async function runHeuristicBatch() {
      showStatus('Trwa rekonstrukcja polskich znaków, ułamków i normalizacja tekstu...', 'info');
      try {
        if (!await triggerAction('clean')) return;
        showStatus('Trwa kompilacja czystego EPUB 3 przez Pandoc...', 'info');
        if (!await triggerAction('build')) return;
        showStatus('Odświeżanie audytu jakościowego...', 'info');
        if (!await triggerAction('audit')) return;
        showStatus(`Czyszczenie i budowa EPUB zakończone. Pozostało anomalii: ${globalReport?.anomalies?.length ?? 'brak raportu'}.`, 'info');
      } catch (err) {
        showStatus('Błąd: ' + err.message, 'error');
      }
    }

