    // Inicjalizacja: natychmiastowe podpięcie słuchaczy zdarzeń, następnie pobranie listy książek i statusu
    async function init() {
      setupEventListeners();
      await loadBooks();
      await fetchStatus();
    }

    async function loadBooks() {
      try {
        const res = await fetch('/api/files');
        const data = await res.json();
        if (data.books && data.books.length > 0) {
          const currentVal = bookSelector.value;
          bookSelector.innerHTML = data.books.map(b => {
            const badge = b.hasEpub ? '✓ EPUB gotowy' : b.hasMd ? 'MD gotowy' : 'Tylko PDF';
            return `<option value="${b.stem}">${b.stem} (${badge})</option>`;
          }).join('');
          if (currentVal && data.books.some(b => b.stem === currentVal)) {
            bookSelector.value = currentVal;
          }
        }
      } catch (e) {
        console.error('Błąd pobierania listy książek:', e);
      }
    }

    async function fetchHistoryStatuses() {
      const currentBook = (typeof bookSelector !== 'undefined' && bookSelector && bookSelector.value) ? bookSelector.value : 'ksiazka';
      try {
        const res = await fetch(`/api/history?book=${encodeURIComponent(currentBook)}`);
        const data = await res.json();
        if (data && data.success && data.ledger && Array.isArray(data.ledger.records)) {
          for (const rec of data.ledger.records) {
            const idx = rec.paragraph_index;
            if (rec.decision === 'applied') {
              saveStatuses.set(`${currentBook}:${idx}`, 'saved');
            } else if (rec.decision === 'verified') {
              verifyStatuses.set(`${currentBook}:${idx}`, 'verified');
            } else if (rec.decision === 'rejected') {
              verifyStatuses.set(`${currentBook}:${idx}`, 'rejected');
            }
          }
        }
      } catch (e) {
        console.warn('Błąd pobierania historii:', e);
      }
    }

    async function fetchStatus() {
      const currentBook = bookSelector.value || 'ksiazka';
      try {
        const res = await fetch(`/api/status?book=${encodeURIComponent(currentBook)}`);
        const data = await res.json();
        globalStatusData = data;

        // 1. Wskaźnik Ollama i selektor modeli
        globalOllama = data.ollama || { available: false, models: [] };
        const modelSelector = document.getElementById('modelSelector');
        if (globalOllama.available) {
          ollamaBadge.className = 'flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs font-mono bg-emerald-500/10 border-emerald-500/30 text-emerald-300 cursor-pointer hover:border-emerald-400';
          ollamaPing.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75';
          ollamaDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-emerald-500';
          const defaultModel = globalOllama.models[0] || 'qwen2.5:14b';
          ollamaText.textContent = `Ollama Online (${defaultModel})`;
          document.getElementById('statModelName').textContent = `Ollama: ${defaultModel}`;

          if (modelSelector && globalOllama.models && globalOllama.models.length > 0) {
            const currentVal = modelSelector.value;
            const llmModels = globalOllama.models.filter(m => !m.includes('embed'));
            const embedModels = globalOllama.models.filter(m => m.includes('embed'));
            const allOptions = [...llmModels, ...embedModels];

            modelSelector.innerHTML = allOptions.map(m => {
              const isEmbed = m.includes('embed');
              const suffix = isEmbed ? ' (Embedding — nie służy do napraw)' : '';
              return `<option value="${escapeHtml(m)}" ${isEmbed ? 'disabled' : ''}>${escapeHtml(m)}${suffix}</option>`;
            }).join('') + '<option value="heuristic">Silnik Regułowy (Wbudowany)</option>';

            const saved = localStorage.getItem('selectedOllamaModel');
            if (saved && allOptions.includes(saved)) {
              modelSelector.value = saved;
            } else if (currentVal && allOptions.includes(currentVal)) {
              modelSelector.value = currentVal;
            } else if (llmModels.length > 0) {
              modelSelector.value = llmModels[0];
            }
          }
        } else {
          ollamaBadge.className = 'flex items-center gap-2 px-3 py-1.5 rounded-lg border text-xs font-mono bg-zinc-800 border-zinc-700 text-zinc-400 cursor-pointer hover:border-zinc-500';
          ollamaPing.className = 'hidden';
          ollamaDot.className = 'relative inline-flex rounded-full h-2 w-2 bg-zinc-500';
          ollamaText.textContent = 'Ollama Offline (Kliknij po instrukcję Windows)';
          document.getElementById('statModelName').textContent = 'Autopilot Wbudowany / VS Code';
        }

        // 2. Metryki Markdown (auto-tworzenie info)
        if (data.mdInfo && data.mdInfo.exists) {
          document.getElementById('statMdLines').textContent = data.mdInfo.lines.toLocaleString();
          document.getElementById('statMdSize').textContent = `Rozmiar: ${data.mdInfo.size}`;
          document.getElementById('statMdStatus').textContent = 'Zsynchronizowany';
          document.getElementById('statMdStatus').className = 'text-emerald-400 font-medium';
        } else {
          document.getElementById('statMdLines').textContent = 'Brak';
          document.getElementById('statMdSize').textContent = 'Rozmiar: 0 MB';
          document.getElementById('statMdStatus').textContent = 'Utworzy się automatycznie';
          document.getElementById('statMdStatus').className = 'text-amber-400 font-medium';
        }

        // 3. Metryki EPUB
        if (data.epubInfo && data.epubInfo.exists) {
          document.getElementById('statEpubSize').textContent = data.epubInfo.size;
          document.getElementById('statEpubTime').textContent = `Kompilacja: ${data.epubInfo.mtime}`;
          document.getElementById('statEpubLabel').textContent = `${data.epubInfo.filename}`;
          btnDownloadEpub.href = `/api/download?file=${encodeURIComponent(data.epubInfo.filename)}`;
          btnDownloadEpub.classList.remove('pointer-events-none', 'opacity-50');
        } else {
          document.getElementById('statEpubSize').textContent = 'Brak';
          document.getElementById('statEpubTime').textContent = 'Wymaga kompilacji';
          document.getElementById('statEpubLabel').textContent = `${currentBook}.epub`;
          btnDownloadEpub.classList.add('pointer-events-none', 'opacity-50');
        }

        // 4. Anomalie i raport
        globalReport = data.report;
        if (globalReport && globalReport.anomalies) {
          const total = globalReport.total_anomalies || globalReport.anomalies.length;
          const high = globalReport.by_severity?.HIGH || globalReport.high_severity_count || 0;
          const med = globalReport.by_severity?.MEDIUM || globalReport.medium_severity_count || 0;
          const low = globalReport.by_severity?.LOW || globalReport.low_severity_count || 0;

          document.getElementById('statAnomalyTotal').textContent = total;
          document.getElementById('statHighBadge').textContent = `High: ${high}`;
          document.getElementById('statMedBadge').textContent = `Med: ${med}`;
          document.getElementById('statLowBadge').textContent = `Low: ${low}`;
          if (anomalyCounterBadge) anomalyCounterBadge.textContent = `${total} usterek`;

          await fetchHistoryStatuses();
          renderAnomalies();
        } else {
          const statTotal = document.getElementById('statAnomalyTotal');
          if (statTotal) statTotal.textContent = '0';
          const statHigh = document.getElementById('statHighBadge');
          if (statHigh) statHigh.textContent = 'High: 0';
          const statMed = document.getElementById('statMedBadge');
          if (statMed) statMed.textContent = 'Med: 0';
          const statLow = document.getElementById('statLowBadge');
          if (statLow) statLow.textContent = 'Low: 0';
          if (anomalyCounterBadge) anomalyCounterBadge.textContent = '0 usterek';

          anomaliesList.innerHTML = `
            <div class="bg-zinc-900/60 border border-zinc-800 rounded-xl p-8 text-center text-zinc-400">
              <p class="font-medium">Brak wygenerowanego raportu audytu dla ${currentBook}.</p>
              <p class="text-xs text-zinc-500 mt-1">Kliknij "Ekstrahuj z PDF" lub "Uruchom Audyt", aby rozpocząć przetwarzanie.</p>
            </div>
          `;
        }
        updateWorkflowStepper(data);
      } catch (e) {
        console.error('Błąd odświeżania statusu:', e);
      }
    }

    function renderAnomalies() {
      if (!globalReport || !globalReport.anomalies) return;

      let list = globalReport.anomalies;

      if (activeFilter !== 'ALL') {
        list = list.filter(a => a.severity.toUpperCase() === activeFilter);
      }

      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase();
        list = list.filter(a => 
          (a.paragraph_index !== undefined && a.paragraph_index.toString().includes(q)) ||
          (a.raw_paragraph && a.raw_paragraph.toLowerCase().includes(q)) ||
          (a.snippet && a.snippet.toLowerCase().includes(q)) ||
          (a.reason && a.reason.toLowerCase().includes(q))
        );
      }

      for (const item of globalReport.anomalies) {
        if (repairStates.get(`${bookSelector.value}:${item.paragraph_index}`)?.working && !list.includes(item)) list = [...list, item];
      }
      if (list.length === 0) {
        anomaliesList.innerHTML = `
          <div class="bg-zinc-900/30 border border-zinc-800/80 rounded-xl p-8 text-center text-zinc-400">
            <svg class="w-8 h-8 mx-auto text-emerald-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <p class="font-semibold text-white">Brak anomalii w tej kategorii!</p>
            <p class="text-xs text-zinc-500 mt-1">Wszystkie akapity są czyste lub zostały zrekonstruowane.</p>
          </div>
        `;
        return;
      }

      anomaliesList.innerHTML = list.map(item => {
        const pIdx = item.paragraph_index;
        const sev = (item.severity || 'low').toUpperCase();
        const severityClass = sev === 'HIGH' 
          ? 'bg-rose-500/10 border-rose-500/30 text-rose-400' 
          : sev === 'MEDIUM' 
            ? 'bg-amber-500/10 border-amber-500/30 text-amber-400' 
            : 'bg-zinc-800 border-zinc-700 text-zinc-300';

        const displaySnippet = item.raw_paragraph || item.snippet || '';
        const currentBook = (typeof bookSelector !== 'undefined' && bookSelector && bookSelector.value) ? bookSelector.value : 'ksiazka';
        const pageEst = item.page || (item.approx_line ? Math.max(1, Math.round(item.approx_line / 35)) : Math.max(1, Math.min(914, Math.round((pIdx / (globalReport?.total_paragraphs || 8084)) * 914))));
        const currentSaveMap = (typeof saveStatuses !== 'undefined') ? saveStatuses : new Map();
        const currentVerifyMap = (typeof verifyStatuses !== 'undefined') ? verifyStatuses : new Map();
        const saveState = currentSaveMap.get(`${currentBook}:${pIdx}`) || 'unsaved';
        const verifyState = currentVerifyMap.get(`${currentBook}:${pIdx}`) || 'pending';
        const isSaved = saveState === 'saved';
        const saveBadgeClass = isSaved 
          ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-semibold' 
          : 'bg-zinc-800 text-zinc-400 border border-zinc-700';
        const saveBadgeText = isSaved ? '✓ Zapisany w MD' : 'Niezapisany';

        const verifyBadgeClass = verifyState === 'verified'
          ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-semibold'
          : verifyState === 'rejected'
            ? 'bg-rose-500/20 text-rose-300 border border-rose-500/30 font-semibold'
            : 'bg-zinc-800 text-zinc-400 border border-zinc-700';
        const verifyBadgeText = verifyState === 'verified'
          ? '✓ Zweryfikowany (OK)'
          : verifyState === 'rejected'
            ? '✗ Odrzucony'
            : 'Oczekuje na weryfikację';

        return `
          <div class="bg-zinc-900/80 border border-zinc-800 hover:border-zinc-700/80 rounded-2xl p-4 transition space-y-3 shadow-lg" id="card-${pIdx}">
            <!-- Header bar -->
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-zinc-800/80 pb-2.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-zinc-800 text-zinc-200 border border-zinc-700">#${pIdx}</span>
                <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded border ${severityClass}">${sev}</span>
                <!-- Osobne statusy zapisu oraz weryfikacji -->
                <span id="save-status-${pIdx}" class="text-[10px] font-mono px-2 py-0.5 rounded ${saveBadgeClass}">${saveBadgeText}</span>
                <span id="verify-status-${pIdx}" class="text-[10px] font-mono px-2 py-0.5 rounded ${verifyBadgeClass}">${verifyBadgeText}</span>
                <span class="text-xs font-medium text-zinc-300">${escapeHtml(item.reason || item.categories?.join(', ') || 'Anomalia OCR')}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <button onclick="toggleScan(${pIdx})" class="px-2 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg text-xs font-medium border border-zinc-700 transition flex items-center gap-1" title="Podgląd wycinka/skanu strony PDF">
                  <span>🔍 Skan PDF</span>
                </button>
                <button onclick="toggleHistory(${pIdx})" class="px-2 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg text-xs font-medium border border-zinc-700 transition flex items-center gap-1" title="Pokaż historię decyzji i audyt zmian">
                  <span>📜 Historia</span>
                </button>
                <button onclick="requestOllamaRepair(${pIdx})" class="px-2.5 py-1 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 rounded-lg text-xs font-medium border border-emerald-500/30 transition flex items-center gap-1 shadow-sm active:scale-95" title="Napraw z użyciem wybranego modelu LLM">
                  <span>⚡ AI Fix</span>
                </button>
                <button onclick="requestScanOcrRepair(${pIdx})" class="px-2.5 py-1 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 rounded-lg text-xs font-medium border border-indigo-500/30 transition flex items-center gap-1 active:scale-95" title="Bezpośrednia transkrypcja z wycinka skanu (RapidOCR + VLM)">
                  <span>📷 Skan OCR</span>
                </button>
                <button onclick="applyHeuristicToCard(${pIdx})" class="px-2.5 py-1 bg-amber-600/20 hover:bg-amber-600/30 text-amber-300 rounded-lg text-xs font-medium border border-amber-500/30 transition flex items-center gap-1 active:scale-95" title="Szybka naprawa znaków i ułamków">
                  <span>Rekonstrukcja</span>
                </button>
                <button onclick="toggleEdit(${pIdx})" class="px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg text-xs font-medium border border-zinc-700 transition">
                  Edytuj
                </button>
              </div>
            </div>

            <!-- SCAN PREVIEW PANEL -->
            <div id="scan-box-${pIdx}" class="p-3 bg-zinc-950/80 rounded-xl border border-zinc-800 space-y-2 hidden">
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
                <span class="text-zinc-300 font-bold flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  Wycinek / Skan strony PDF: <span id="scan-page-label-${pIdx}" class="text-emerald-400 font-bold">strona ${pageEst}</span>
                </span>
                <div class="flex items-center gap-1.5">
                  <button onclick="stepScanPage(${pIdx}, -1)" class="px-1.5 py-0.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs rounded border border-zinc-700" title="Poprzednia strona">◀</button>
                  <label class="text-[11px] text-zinc-400">Strona:</label>
                  <input type="number" id="scan-page-input-${pIdx}" value="${pageEst}" min="1" max="914" class="w-16 bg-zinc-900 border border-zinc-700 rounded px-1.5 py-0.5 text-xs font-mono text-white text-center" />
                  <button onclick="stepScanPage(${pIdx}, 1)" class="px-1.5 py-0.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs rounded border border-zinc-700" title="Następna strona">▶</button>
                  <button onclick="reloadScan(${pIdx})" class="px-2 py-0.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs rounded border border-zinc-700">Wczytaj</button>
                  <button onclick="openScanModal(${pIdx})" class="px-2.5 py-0.5 bg-emerald-600/30 hover:bg-emerald-600/50 text-emerald-300 text-xs rounded border border-emerald-500/40 font-semibold flex items-center gap-1" title="Otwórz pełny ekran z funkcją Pan & Zoom">🔍 Pełny ekran</button>
                  <button onclick="toggleScan(${pIdx})" class="text-zinc-500 hover:text-zinc-300 text-xs ml-1">Zamknij</button>
                </div>
              </div>
              <div class="flex flex-col items-center bg-zinc-900/50 rounded-lg p-2 border border-zinc-800/80 overflow-hidden relative group">
                <img id="scan-img-${pIdx}" src="/api/scan-image?book=${encodeURIComponent(currentBook)}&page=${pageEst}" alt="Skan strony #${pageEst}" class="max-h-[500px] max-w-full rounded border border-zinc-700/60 object-contain shadow-md cursor-zoom-in transition-transform duration-200" onclick="openScanModal(${pIdx})" onerror="this.onerror=null; this.alt='Nie udało się załadować obrazu skanu';" loading="lazy" />
                <div class="mt-2 flex items-center justify-between w-full text-[11px] font-mono text-zinc-400 px-1">
                  <span>Kliknij obraz, aby otworzyć powiększenie i przesuwanie (Pan & Zoom)</span>
                  <a id="scan-direct-link-${pIdx}" href="/api/scan-image?book=${encodeURIComponent(currentBook)}&page=${pageEst}" target="_blank" class="text-cyan-400 hover:underline">Otwórz plik PNG (nowa karta) ↗</a>
                </div>
              </div>
            </div>

            <!-- DECISION HISTORY PANEL -->
            <div id="history-box-${pIdx}" class="p-3 bg-zinc-950/80 rounded-xl border border-zinc-800 space-y-2 hidden">
              <div class="flex items-center justify-between text-xs font-mono border-b border-zinc-800/80 pb-1.5">
                <span class="text-zinc-300 font-bold flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  Historia decyzji i audyt zmian akapitu #${pIdx}
                </span>
                <button onclick="toggleHistory(${pIdx})" class="text-zinc-500 hover:text-zinc-300 text-xs">Zamknij</button>
              </div>
              <div id="history-content-${pIdx}" class="text-xs space-y-2 max-h-56 overflow-y-auto">
                <span class="text-zinc-500 italic">Kliknij, aby wczytać historię...</span>
              </div>
            </div>

            <!-- TWO-COLUMN BEFORE / AFTER VIEW -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="diff-grid-${pIdx}">
              <!-- Column 1: PRZED (Oryginał OCR) -->
              <div class="bg-rose-950/20 border border-rose-900/40 rounded-xl p-3 flex flex-col justify-between space-y-2">
                <div class="flex items-center justify-between text-[11px] font-mono text-rose-300 font-bold border-b border-rose-900/40 pb-1">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                    PRZED (Oryginał OCR)
                  </span>
                  <span class="text-[10px] text-rose-400/80 font-normal">Szum i usterki</span>
                </div>
                <div class="text-xs font-mono text-rose-200/90 whitespace-pre-wrap leading-relaxed py-1">
                  ${highlightIssues(displaySnippet)}
                </div>
                <div class="text-[10px] font-mono text-rose-400/70 border-t border-rose-900/30 pt-1 flex items-center justify-between">
                  <span>Wykryte błędy: ${escapeHtml(item.categories?.join(', ') || 'szum OCR')}</span>
                </div>
              </div>

              <!-- Column 2: PO (Zrekonstruowany tekst) -->
              <div class="bg-emerald-950/20 border border-emerald-900/40 rounded-xl p-3 flex flex-col justify-between space-y-2" id="after-col-${pIdx}">
                <div class="flex items-center justify-between text-[11px] font-mono text-emerald-300 font-bold border-b border-emerald-900/40 pb-1">
                  <span class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    PO (Zrekonstruowany)
                  </span>
                  <span id="quality-badge-${pIdx}" class="text-[10px] px-1.5 py-0.5 rounded font-bold bg-zinc-800 text-zinc-400">Podgląd</span>
                </div>
                <div id="repaired-preview-${pIdx}" class="text-xs font-mono text-emerald-200/90 whitespace-pre-wrap leading-relaxed py-1">
                  ${escapeHtml(reconstructParagraphHeuristic(displaySnippet))}
                </div>
                <div id="metrics-footer-${pIdx}" class="text-[10px] font-mono text-emerald-400/80 border-t border-emerald-900/30 pt-1 flex flex-wrap items-center justify-between gap-1.5">
                  <span>Propozycja algorytmiczna</span>
                  <div class="flex items-center gap-1.5">
                    <button onclick="markVerified(${pIdx})" class="px-2 py-0.5 rounded bg-cyan-600/20 hover:bg-cyan-600/30 text-cyan-300 border border-cyan-500/30 text-[10px] font-medium transition" title="Oznacz akapit jako zweryfikowany i poprawny">✓ Zweryfikuj</button>
                    <button onclick="markRejected(${pIdx})" class="px-2 py-0.5 rounded bg-rose-600/20 hover:bg-rose-600/30 text-rose-300 border border-rose-500/30 text-[10px] font-medium transition" title="Oznacz akapit jako odrzucony">✗ Odrzuć</button>
                    <button onclick="applyHeuristicToCard(${pIdx})" class="text-emerald-300 hover:text-white underline text-[10px]">Zatwierdź wersję</button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Edit / Patch Panel -->
            <div id="edit-box-${pIdx}" class="space-y-2 pt-2 border-t border-zinc-800/60 hidden">
              <label class="text-[11px] font-semibold text-zinc-400">Ręczna korekta tekstu akapitu:</label>
              <textarea id="input-${pIdx}" class="w-full h-24 bg-zinc-950 border border-zinc-700 rounded-lg p-2.5 text-xs font-mono text-zinc-100 focus:outline-none focus:border-emerald-500">${escapeHtml(reconstructParagraphHeuristic(displaySnippet))}</textarea>
              <div class="flex justify-end gap-2">
                <button onclick="toggleEdit(${pIdx})" class="px-3 py-1.5 text-xs text-zinc-400 hover:text-zinc-200">Anuluj</button>
                <button onclick="applyPatch(${pIdx})" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold shadow transition">
                  Zapisz do Markdown
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
      for (const [key, state] of repairStates) {
        if (key.startsWith(`${bookSelector.value}:`)) displayRepairState(Number(key.split(':').pop()), state);
      }
    }

    function displayRepairState(pIdx, state) {
      const card = document.getElementById(`card-${pIdx}`);
      card?.setAttribute('aria-busy', state.working ? 'true' : 'false');
      if (state.working) card?.classList.add('ring-2', 'ring-cyan-400', 'animate-pulse');
      else card?.classList.remove('ring-2', 'ring-cyan-400', 'animate-pulse');
      const badge = document.getElementById(`quality-badge-${pIdx}`);
      const preview = document.getElementById(`repaired-preview-${pIdx}`);
      const footer = document.getElementById(`metrics-footer-${pIdx}`);
      const input = document.getElementById(`input-${pIdx}`);
      const saveBadge = document.getElementById(`save-status-${pIdx}`);
      const verifyBadge = document.getElementById(`verify-status-${pIdx}`);

      if (badge) {
        badge.classList.remove('animate-pulse');
        badge.textContent = state.label;
      }
      if (preview) preview.textContent = state.text;
      if (footer) footer.textContent = state.details;
      if (input && state.text && !state.working) input.value = state.text;

      if (saveBadge && (state.saved || state.label?.startsWith('Zapisano'))) {
        saveBadge.className = 'text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        saveBadge.textContent = '✓ Zapisany w MD';
      }
      if (verifyBadge) {
        if (state.verified) {
          verifyBadge.className = 'text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30';
          verifyBadge.textContent = '✓ Zweryfikowany (OK)';
        } else if (state.rejected) {
          verifyBadge.className = 'text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30';
          verifyBadge.textContent = '✗ Odrzucony';
        }
      }
    }

    function rememberRepair(pIdx, data) {
      const sourcePages = [...new Set((data.sources || []).flatMap(s => s.pages))];
      const curBook = (typeof bookSelector !== 'undefined' && bookSelector && bookSelector.value) ? bookSelector.value : 'ksiazka';
      const isApplied = Boolean(data.success && data.applied);
      if (isApplied && typeof saveStatuses !== 'undefined') {
        saveStatuses.set(`${curBook}:${pIdx}`, 'saved');
      }
      const state = {
        saved: isApplied,
        label: isApplied ? (data.method === 'source-ocr' ? 'Zapisano — ponowny OCR źródła' : data.method === 'heuristic' ? 'Zapisano reguły — sprawdź audyt' : 'Zapisano — korekta tekstowa') : 'Do kontroli — nie zapisano',
        text: data.repaired || 'Brak wyniku rekonstrukcji.',
        details: isApplied
          ? `Zapisano do Markdown. ${sourcePages.length ? `Źródło: strony PDF ${sourcePages.join(', ')}. ` : ''}Podobieństwo do starego OCR: ${data.metrics?.similarity ?? '—'}% (ocena heurystyczna).`
          : `${data.error || 'Nie zapisano zmian.'} ${sourcePages.length ? `Sprawdzono strony PDF: ${sourcePages.join(', ')}.` : ''} Propozycja wymaga kontroli.`,
      };
      repairStates.set(`${curBook}:${pIdx}`, state);
      displayRepairState(pIdx, state);
      return state;
    }

    function highlightIssues(text) {
      if (!text) return '';
      let safe = escapeHtml(text);
      safe = safe.replace(/(\^|°|£|¥|«|»)/g, '<mark class="bg-rose-500/40 text-rose-200 px-0.5 rounded font-bold">$1</mark>');
      return safe;
    }

    function escapeHtml(str) {
      return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

