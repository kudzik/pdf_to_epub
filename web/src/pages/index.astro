              if (label) label.textContent = `strona ${data.page} (pewność: ${(data.confidence * 100).toFixed(0)}%)`;
              if (img) img.src = `/api/scan-image?book=${encodeURIComponent(currentBook)}&page=${data.page}&t=${Date.now()}`;
