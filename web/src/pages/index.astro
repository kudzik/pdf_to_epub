    async function loadHistoryForCard(pIdx) {
      const container = document.getElementById(`history-content-${pIdx}`);
      if (!container) return;
      container.innerHTML = '<span class="text-zinc-500 italic">Ładowanie historii z rejestru...</span>';
      const currentBook = (typeof bookSelector !== 'undefined' && bookSelector && bookSelector.value) ? bookSelector.value : 'ksiazka';
      try {
        const res = await fetch(`/api/history?book=${encodeURIComponent(currentBook)}`);
        const data = await res.json();
        if (!data.success || !data.ledger || !Array.isArray(data.ledger.records)) {
          container.innerHTML = '<span class="text-zinc-500 italic">Brak zapisanej historii.</span>';
          return;
        }
        const records = data.ledger.records.filter(r => r.paragraph_index === pIdx);
        if (records.length === 0) {
          container.innerHTML = '<span class="text-zinc-500 italic">Brak wpisów w historii dla tego akapitu. Decyzje i modyfikacje pojawią się tutaj po zatwierdzeniu.</span>';
          return;
        }
        container.innerHTML = records.map(r => {
          const dateStr = new Date(r.timestamp).toLocaleTimeString('pl-PL') + ' ' + new Date(r.timestamp).toLocaleDateString('pl-PL');
          const dec = (r.decision || 'applied').toLowerCase();
          const decClass = dec === 'applied' 
            ? 'text-emerald-400 bg-emerald-500/10 border-emerald-500/30'
            : dec === 'verified'
              ? 'text-cyan-400 bg-cyan-500/10 border-cyan-500/30'
              : dec === 'rejected'
                ? 'text-rose-400 bg-rose-500/10 border-rose-500/30'
                : 'text-zinc-400 bg-zinc-800 border-zinc-700';
          const anchor = data.anchors && data.anchors[r.record_id];
          const anchorText = anchor ? (anchor.status === 'valid' ? '✓ Kotwica OK' : anchor.status === 'shifted' ? `↕ Przesunięty (${anchor.shift_offset})` : '⚠ Zgubiona kotwica') : '';

          return `
            <div class="p-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-xs font-mono space-y-1">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                  <span class="px-1.5 py-0.5 rounded border text-[10px] font-bold ${decClass}">${dec.toUpperCase()}</span>
                  <span class="text-zinc-300 font-medium">${escapeHtml(r.source_engine || 'studio')}</span>
                </div>
                <span class="text-[10px] text-zinc-500">${dateStr}</span>
              </div>
              <div class="text-zinc-300 text-[11px] font-sans">
                <strong>Powód:</strong> ${escapeHtml(r.decision_reason || 'Brak uzasadnienia')}
              </div>
              ${anchorText ? `<div class="text-[10px] text-zinc-500">Stan kotwicy: <span class="text-zinc-400">${anchorText}</span> &middot; Rekord: #${r.record_id}</div>` : ''}
            </div>
          `;
        }).reverse().join('');
      } catch (err) {
        container.innerHTML = `<span class="text-rose-400">Błąd ładowania historii: ${escapeHtml(err.message)}</span>`;
      }
    }

