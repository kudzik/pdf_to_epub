    // System powiadomień Toast (Zastępuje natywne browser alert)
    function showToast(message, type = 'info', duration = 3500) {
      const container = document.getElementById('toastContainer');
      if (!container) return;

      const toast = document.createElement('div');
      let colorClasses = 'bg-zinc-900/95 border-zinc-700 text-zinc-200';
      if (type === 'success') colorClasses = 'bg-emerald-950/95 border-emerald-500/40 text-emerald-200';
      else if (type === 'error') colorClasses = 'bg-rose-950/95 border-rose-500/40 text-rose-200';
      else if (type === 'warning') colorClasses = 'bg-amber-950/95 border-amber-500/40 text-amber-200';

      toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-xl border shadow-2xl text-xs font-medium transition-all duration-300 transform translate-y-2 opacity-0 backdrop-blur-md ${colorClasses}`;
      toast.innerHTML = `<span>${escapeHtml(message)}</span>`;

      container.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
      });

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, duration);
    }

    // Bezpieczne kopiowanie do schowka z powiadomieniem
    window.copyToClipboard = function(text, successMsg = 'Skopiowano do schowka!') {
