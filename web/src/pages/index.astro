    window.requestOllamaRepair = async function(pIdx) {
      if (isAutopilotRunning || activeRepairController) return;
      const currentBook = bookSelector.value || 'ksiazka';
      const anomaly = globalReport.anomalies.find(a => a.paragraph_index === pIdx);
      if (!anomaly) return;
      const card = document.getElementById(`card-${pIdx}`);
      if (card?.getAttribute('aria-busy') === 'true') return;
      card?.setAttribute('aria-busy', 'true');
      card?.classList.add('ring-2', 'ring-cyan-400');
      activeRepairController = new AbortController();
      bookSelector.disabled = true;
      repairStates.set(`${currentBook}:${pIdx}`, { working: true, label: 'Trwa naprawa', text: 'Naprawa tekstu i w razie potrzeby odczyt PDF…', details: 'Oczekiwanie na wynik; plik nie został jeszcze zmieniony.' });
      let elapsed = 0;
      const timer = setInterval(() => {
        const badge = document.getElementById(`quality-badge-${pIdx}`);
        const pending = repairStates.get(`${currentBook}:${pIdx}`);
        if (pending?.working) {
          pending.label = `Naprawa / odczyt PDF: ${++elapsed} s`;
          displayRepairState(pIdx, pending);
        }
      }, 1000);

      const modelSelect = document.getElementById('modelSelector');
      const selectedModel = modelSelect ? modelSelect.value : 'qwen2.5:14b';

      const qualityBadge = document.getElementById(`quality-badge-${pIdx}`);
      const metricsFooter = document.getElementById(`metrics-footer-${pIdx}`);
      const previewEl = document.getElementById(`repaired-preview-${pIdx}`);
      const textarea = document.getElementById(`input-${pIdx}`);

      if (qualityBadge) {
        qualityBadge.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-cyan-500/20 text-cyan-300 animate-pulse';
        qualityBadge.textContent = `Generowanie (${selectedModel})...`;
      }
      if (previewEl) {
        previewEl.innerHTML = `<span class="text-zinc-400 italic">Trwa zapytanie do modelu ${escapeHtml(selectedModel)}...</span>`;
      }

      try {
        const res = await fetch('/api/ollama-repair', {
          signal: activeRepairController.signal,
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            index: pIdx,
            paragraph: anomaly.raw_paragraph || anomaly.snippet,
            reason: anomaly.reason || anomaly.categories?.join(', '),
            file: `${currentBook}.md`,
            model: selectedModel,
            apply: true
          })
        });
        const data = await res.json();
        if (data.success && data.applied && data.repaired) {
          if (textarea) textarea.value = data.repaired;
          if (previewEl) previewEl.textContent = data.repaired;
          anomaly.raw_paragraph = data.repaired;
          rememberRepair(pIdx, data);
          showToast(`✓ Akapit #${pIdx} zrekonstruowany i zapisany (${selectedModel})!`, 'success');
        } else {
          showToast('Ollama: ' + (data.error || 'Błąd odpowiedzi'), 'warning');
          rememberRepair(pIdx, data);

        }
      } catch (err) {
        rememberRepair(pIdx, { error: err.message });
        showToast('Błąd komunikacji z modelem: ' + err.message, 'error');
        if (qualityBadge) qualityBadge.textContent = 'Błąd połączenia — nie zapisano';
        if (previewEl) previewEl.textContent = 'Brak wyniku rekonstrukcji.';
        if (metricsFooter) metricsFooter.textContent = err.message;
      } finally {
        clearInterval(timer);
        activeRepairController = null;
        bookSelector.disabled = false;
        card?.classList.remove('ring-2', 'ring-cyan-400');
        qualityBadge?.classList.remove('animate-pulse');
        card?.setAttribute('aria-busy', 'false');
      }
    };

    // Wbudowany algorytmiczny silnik rekonstrukcji tekstu (polskie znaki, ułamki, szumy OCR)
    function reconstructParagraphHeuristic(text) {
      if (!text) return '';
      let t = text;
      // Scalanie rozbitych słów (de-hyphenation)
      t = t.replace(/(\b[a-zA-ZąćęłńóśźżĄĆĘŁŃÓŚŹŻ]+)-\s+([a-zA-ZąćęłńóśźżĄĆĘŁŃÓŚŹŻ]+\b)/g, '$1$2');
      // Ułamki
      t = t.replace(/\bVz\b/g, '1/2');
      t = t.replace(/\b¥2\b/g, '1/2');
      t = t.replace(/3\/«/g, '3/4');
      t = t.replace(/½/g, '1/2');
      t = t.replace(/¼/g, '1/4');
      t = t.replace(/¾/g, '3/4');
      t = t.replace(/\b1\s+2\s+(tsp|tbsp|cup|cups|teaspoon|tablespoon|lb|lbs|oz|clove|pinch|stick)\b/gi, '1/2 $1');
      t = t.replace(/\b1\s+4\s+(tsp|tbsp|cup|cups|teaspoon|tablespoon|lb|lbs|oz|clove|pinch|stick)\b/gi, '1/4 $1');
      t = t.replace(/\b3\s+4\s+(tsp|tbsp|cup|cups|teaspoon|tablespoon|lb|lbs|oz|clove|pinch|stick)\b/gi, '3/4 $1');
      // Zbitki OCR (ha^been -> has been itp.)
      t = t.replace(/\bha\^been\b/g, 'has been');
      t = t.replace(/\bin\s+die\s+oven\b/gi, 'in the oven');
      t = t.replace(/\bin\s+die\s+/gi, 'in the ');
      t = t.replace(/\bdie\s+oven\b/gi, 'the oven');
      t = t.replace(/\bdie\s+sauce\b/gi, 'the sauce');
      t = t.replace(/\bdie\s+pan\b/gi, 'the pan');
      t = t.replace(/\bdie\s+meat\b/gi, 'the meat');
      // Polskie diakrytyki i usterki OCR
      t = t.replace(/\bgol\^bki\b/gi, 'gołąbki');
      t = t.replace(/\bgolgbki\b/gi, 'gołąbki');
      t = t.replace(/\bkapust\^/gi, 'kapustą');
      t = t.replace(/\bw\^trob/gi, 'wątrób');
      t = t.replace(/\bpstr\^g/gi, 'pstrąg');
      t = t.replace(/\bmies\^/gi, 'mięsa');
      t = t.replace(/saut£/g, 'sauté');
      t = t.replace(/pur£e/g, 'purée');
      t = t.replace(/canap£/g, 'canapé');
      t = t.replace(/£wiez/gi, 'śwież');
      t = t.replace(/£mietan/gi, 'śmietan');
      t = t.replace(/£liw/gi, 'śliw');
      t = t.replace(/kurcz£/gi, 'kurczę');
      // Szumy skanera
      t = t.replace(/■\s*\^p-/g, '');
      t = t.replace(/FlraS\s*-\*/g, '');
      return t;
    }

    // AUTOPILOT AI (Z dynamicznym wyborem modelu z Ollama lub silnika regułowego)
    async function startOllamaAutopilot() {
      if (!globalReport || !globalReport.anomalies || globalReport.anomalies.length === 0) {
        showStatus('Brak wykrytych anomalii do naprawy. Audyt nie gwarantuje poprawności całego tekstu.', 'info');
        return;
      }

      if (isAutopilotRunning || activeRepairController) return;
      const currentBook = bookSelector.value || 'ksiazka';
      const anomalies = [...globalReport.anomalies];
      const total = anomalies.length;

      const modelSelect = document.getElementById('modelSelector');
      const selectedModel = modelSelect ? modelSelect.value : 'qwen2.5:14b';
      const isHeuristicOnly = selectedModel === 'heuristic';
      const isAiOnline = !isHeuristicOnly && globalOllama && globalOllama.available;
      if (!isHeuristicOnly && !isAiOnline) {
        showStatus('Ollama jest niedostępna. Uruchom model lub wybierz jawnie silnik regułowy.', 'error');
        return;
      }
      const engineName = isAiOnline ? `Ollama (${selectedModel})` : 'Silnik Regułowy';

      isAutopilotRunning = true;
      stopRequested = false;

      autopilotProgressBox.classList.remove('hidden');
      btnStartOllamaAutopilot.classList.add('opacity-50', 'pointer-events-none');
      
      showStatus(`Uruchamianie Autopilota: ${engineName}...`, 'info');

      let repairedCount = 0;
      let failedCount = 0;
      bookSelector.disabled = true;

      const resumeIdx = (typeof autopilotResumeIndex !== 'undefined') ? autopilotResumeIndex : 0;
      const startIndex = (resumeIdx > 0 && resumeIdx < total) ? resumeIdx : 0;

      for (let i = startIndex; i < total; i++) {
        if (stopRequested) {
          if (typeof autopilotResumeIndex !== 'undefined') autopilotResumeIndex = i;
          break;
        }

        const anomaly = anomalies[i];
        const pIdx = anomaly.paragraph_index;
        const percent = Math.round((i / total) * 100);
        const rawSnippet = anomaly.raw_paragraph || anomaly.snippet || '';

        autopilotStepLabel.textContent = `Autopilot [${engineName}]: Akapit #${pIdx} (${i + 1} z ${total})...`;
        autopilotProgressPercent.textContent = `${percent}%`;
        autopilotProgressBar.style.width = `${percent}%`;
        autopilotCurrentDetails.textContent = `Wada: ${anomaly.reason || anomaly.categories?.join(', ') || 'OCR'}`;

        // Live Diff Panel: Aktualizacja akapitu "PRZED"
        const liveDiffIndex = document.getElementById('liveDiffIndex');
        const liveDiffBefore = document.getElementById('liveDiffBefore');
        const liveDiffAfter = document.getElementById('liveDiffAfter');
        const liveDiffQuality = document.getElementById('liveDiffQuality');

        if (liveDiffIndex) liveDiffIndex.textContent = `#${pIdx}`;
        if (liveDiffBefore) liveDiffBefore.textContent = rawSnippet;
        if (liveDiffAfter) liveDiffAfter.innerHTML = `<span class="italic text-zinc-400">Rekonstrukcja w toku (${engineName})...</span>`;
        if (liveDiffQuality) liveDiffQuality.textContent = 'Analiza...';

        repairStates.set(`${currentBook}:${pIdx}`, { working: true, label: '● Teraz naprawiany', text: 'Naprawa tekstu i w razie potrzeby odczyt PDF…', details: 'Oczekiwanie na wynik.' });
        let repairedText = null;
        let metricData = null;
        const card = document.getElementById(`card-${pIdx}`);
        card?.classList.add('ring-2', 'ring-cyan-400', 'animate-pulse');
        card?.setAttribute('aria-busy', 'true');
        card?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        const pendingBadge = document.getElementById(`quality-badge-${pIdx}`);
        if (pendingBadge) pendingBadge.textContent = '● Teraz naprawiany';
        let elapsed = 0;
        const ticker = setInterval(() => {
          elapsed++;
          if (liveDiffQuality) liveDiffQuality.textContent = `Praca: ${elapsed} s`;
          const pending = repairStates.get(`${currentBook}:${pIdx}`);
          if (pending?.working) {
            pending.label = `● Teraz naprawiany (${elapsed} s)`;
            displayRepairState(pIdx, pending);
          }
        }, 1000);
        let repairError = '';

        if (isAiOnline) {
          try {
            activeRepairController = new AbortController();
            const res = await fetch('/api/ollama-repair', {
              signal: activeRepairController.signal,
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                index: pIdx,
                paragraph: rawSnippet,
                reason: anomaly.reason || anomaly.categories?.join(', '),
                file: `${currentBook}.md`,
                model: selectedModel,
                apply: true
              })
            });
            const data = await res.json();
            rememberRepair(pIdx, data);
            if (liveDiffAfter) liveDiffAfter.textContent = data.repaired || data.error;
            if (data.success && data.applied && data.repaired) {
              repairedText = data.repaired;
              anomaly.raw_paragraph = data.repaired;
              if (data.metrics) metricData = data.metrics;
            } else {
              repairError = data.error || 'Nie zapisano poprawki';
            }
          } catch (e) {
            repairError = e.message;
            if (e.name === 'AbortError' || stopRequested) {
              // ANULOWANIE BEZ ZAPISU DO PLIKU
              clearInterval(ticker);
              activeRepairController = null;
              card?.classList.remove('ring-2', 'ring-cyan-400', 'animate-pulse');
              card?.setAttribute('aria-busy', 'false');
              if (typeof autopilotResumeIndex !== 'undefined') autopilotResumeIndex = i;
              break;
            }
            rememberRepair(pIdx, { error: e.message });
          } finally {
            activeRepairController = null;
          }
        }

        // Fallback do silnika regułowego, jeśli Ollama offline lub wybrany silnik regułowy
        if (!isAiOnline && !stopRequested) {
          repairedText = reconstructParagraphHeuristic(rawSnippet);
          try {
            const patchResponse = await fetch('/api/patch', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                index: pIdx,
                text: repairedText,
                original: rawSnippet,
                file: `${currentBook}.md`,
                reason: 'Normalizacja ułamków i szumów OCR (Autopilot)'
              })
            });
            const patchResult = await patchResponse.json();
            if (!patchResponse.ok || !patchResult.success) throw new Error(patchResult.error || 'Błąd zapisu');
            rememberRepair(pIdx, { success: true, applied: patchResult.changed, repaired: repairedText, method: 'heuristic' });
          } catch (err) {
            repairedText = null;
            repairError = err.message;
            rememberRepair(pIdx, { error: err.message });
          }
        }

        clearInterval(ticker);
        const completedPercent = Math.round(((i + 1) / total) * 100);
        autopilotProgressPercent.textContent = `${completedPercent}%`;
        autopilotProgressBar.style.width = `${completedPercent}%`;
        card?.classList.remove('ring-2', 'ring-cyan-400', 'animate-pulse');
        card?.setAttribute('aria-busy', 'false');

        if (stopRequested) {
          if (typeof autopilotResumeIndex !== 'undefined') autopilotResumeIndex = i + 1;
          break;
        }

        if (!repairedText) {
          failedCount++;
          if (liveDiffAfter && !repairStates.has(`${currentBook}:${pIdx}`)) liveDiffAfter.textContent = repairError || 'Brak wyniku naprawy';
          if (liveDiffQuality) liveDiffQuality.textContent = 'Nie zapisano';
          if (pendingBadge) pendingBadge.textContent = 'Do kontroli — nie zapisano';
          continue;
        }
        if (repairedText) {
          const changed = repairedText.trim() !== rawSnippet.trim();
          if (changed) repairedCount++;
          const resultLabel = !changed ? 'Bez zmian — wymaga kontroli' : metricData ? `Jakość: ${metricData.qualityScore}%` : 'Zapisano reguły — sprawdź audyt';

          // 1. Aktualizacja Live Diff Panel
          if (liveDiffAfter) liveDiffAfter.textContent = repairedText;
          if (liveDiffQuality) {
            liveDiffQuality.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300';
            liveDiffQuality.textContent = resultLabel;
          }

          // 2. Aktualizacja karty w katalogu z zachowaniem obu kolumn PRZED i PO
          const qualityBadge = document.getElementById(`quality-badge-${pIdx}`);
          const previewEl = document.getElementById(`repaired-preview-${pIdx}`);
          const metricsFooter = document.getElementById(`metrics-footer-${pIdx}`);
          const textarea = document.getElementById(`input-${pIdx}`);

          if (textarea) textarea.value = repairedText;
          if (previewEl) previewEl.textContent = repairedText;
          if (qualityBadge) {
            qualityBadge.className = 'text-[10px] px-2 py-0.5 rounded font-bold bg-emerald-500/20 text-emerald-300';
            qualityBadge.textContent = resultLabel;
          }
          if (metricsFooter) {
            metricsFooter.innerHTML = `
              <span>Podobieństwo: ${metricData?.similarity ?? '—'}% &middot; Szum: ${metricData?.noiseRemoved ?? '—'} &middot; Liczby: ${metricData ? (metricData.invariantsPreserved ? '✓ Zachowane' : '⚠ Zmienione') : 'Nie oceniono'}</span>
              <span class="text-emerald-400 font-bold">✓ Zapisano do MD (.bak)</span>
            `;
          }
          const savedState = repairStates.get(`${currentBook}:${pIdx}`);
          if (savedState) {
            displayRepairState(pIdx, savedState);
            if (liveDiffQuality) liveDiffQuality.textContent = savedState.label;
          }
        }
      }

      autopilotStepLabel.textContent = stopRequested 
        ? `Autopilot zatrzymany. Zaktualizowano ${repairedCount} akapitów.` 
        : `✓ Zakończono! Zaktualizowano ${repairedCount} z ${total} akapitów. Kompilacja EPUB...`;
      
      btnStartOllamaAutopilot.classList.remove('opacity-50', 'pointer-events-none');
      isAutopilotRunning = false;
      bookSelector.disabled = false;
      if (stopRequested) {
        const resumeBtnText = document.getElementById('btnStartOllamaAutopilotText');
        if (resumeBtnText) {
          const rIdx = typeof autopilotResumeIndex !== 'undefined' ? autopilotResumeIndex : 0;
          resumeBtnText.textContent = `Wznów Autopilot (od #${anomalies[rIdx]?.paragraph_index ?? 0})`;
        }
        return;
      }

      if (typeof autopilotResumeIndex !== 'undefined') autopilotResumeIndex = 0;
      const resumeBtnText = document.getElementById('btnStartOllamaAutopilotText');
      if (resumeBtnText) {
        resumeBtnText.textContent = 'Uruchom Autopilot';
      }

      // Do not build a new EPUB when the run changed no paragraphs.
      if (!repairedCount) {
        showStatus(`Nie zmieniono akapitów. Do kontroli: ${failedCount} z ${total}.`, 'info');
        return;
      }
      // Automatyczna rekompilacja EPUB i ponowny audyt
      showStatus('Kompilacja EPUB z zapisanych poprawek...', 'info');
      if (!await triggerAction('build')) return;
      showStatus('Odświeżanie raportu jakościowego po naprawie...', 'info');
      if (!await triggerAction('audit')) return;
      showStatus(`Zmieniono ${repairedCount} z ${total} akapitów. Błędy: ${failedCount}. Pozostało anomalii: ${globalReport?.anomalies?.length ?? 'brak raportu'}. EPUB przebudowany.`, failedCount ? 'warning' : 'info');
    }

    // Szybka Rekonstrukcja (Polskie znaki, ułamki i auto-rekompilacja EPUB)
