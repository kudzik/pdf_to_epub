    "test:live:heading": "node tests/live-heading.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
